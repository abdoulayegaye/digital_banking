<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane  prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.CompteController">

    <children>
        <!-- Image de compte -->
        <ImageView fitHeight="231.0" fitWidth="99.0" layoutX="184.0" layoutY="17.0" pickOnBounds="true" preserveRatio="true">
<!--            <image>-->
<!--                <Image url="@/images/mes-comptes-appli-1.png" />-->
<!--            </image>-->
        </ImageView>

        <!-- Table des comptes -->
        <TableView fx:id="CompteTb" layoutX="201.0" layoutY="63.0" prefHeight="200.0" prefWidth="385.0">
            <columns>
                <TableColumn fx:id="NUMCPTTb" prefWidth="75.0" text="NUM CPT" />
                <TableColumn fx:id="SOLDETb" prefWidth="75.0" text="SOLDE" />
                <TableColumn fx:id="DATEOUVTb" prefWidth="75.0" text="DATE OUV" />
                <TableColumn fx:id="CLIENTTb" prefWidth="75.0" text="CLIENT" />
            <TableColumn fx:id="IDTb" prefWidth="75.0" text="ID" />
            </columns>
        </TableView>

        <!-- Champs de saisie -->
        <Text  layoutX="14.0" layoutY="186.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Numéro de compte">
            <font>
                <Font name="Arial Rounded MT Bold" size="12.0" />
            </font>
        </Text>
        <TextField fx:id="NumeroCompteTfd" layoutX="14.0" layoutY="200.0" />

        <Text layoutX="14.0" layoutY="236.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Solde">
            <font>
                <Font name="Arial Rounded MT Bold" size="12.0" />
            </font>
        </Text>
        <TextField fx:id="SoldeTfd" layoutX="14.0" layoutY="250.0" />

        <Text layoutX="14.0" layoutY="286.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Date d'ouverture">
            <font>
                <Font name="Arial Rounded MT Bold" size="12.0" />
            </font>
        </Text>

        <Text layoutX="14.0" layoutY="336.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Client">
            <font>
                <Font name="Arial Rounded MT Bold" size="12.0" />
            </font>
        </Text>

        <!-- Boutons d'actions -->
        <Button fx:id="AJOUTERTfd" layoutX="17.0" layoutY="374.0" mnemonicParsing="false" onAction="#ajouter" text="Ajouter">
            <font>
                <Font name="Arial Rounded MT Bold" size="12.0" />
            </font>
        </Button>

        <ButtonBar layoutX="251.0" layoutY="292.0" prefHeight="40.0" prefWidth="200.0">
            <buttons>
                <Button fx:id="ConsulterBtn" mnemonicParsing="false" text="Consulter" />
                <Button fx:id="AssocierBtn" mnemonicParsing="false" text="Associer" />
                <Button fx:id="FermerBtn" mnemonicParsing="false" text="Fermer" />
            </buttons>
        </ButtonBar>
      <DatePicker fx:id="DatedouvertureDtp" layoutX="14.0" layoutY="299.0" />
      <ComboBox fx:id="ClientCb" layoutX="14.0" layoutY="339.0" prefWidth="150.0" />

    </children>
</AnchorPane>
