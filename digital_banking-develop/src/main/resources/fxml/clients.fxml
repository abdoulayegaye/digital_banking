<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/banking-style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.ClientController">
   <children>
      <VBox layoutX="20.0" layoutY="20.0" prefHeight="460.0" prefWidth="350.0" spacing="20.0" styleClass="form-container">
         <children>
            <Label styleClass="panel-header" text="Gestion des Clients" />
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label prefWidth="70.0" styleClass="form-label" text="Nom:" />
                  <TextField fx:id="nomtxt" prefHeight="36.0" prefWidth="230.0" styleClass="form-field" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label prefWidth="70.0" styleClass="form-label" text="Prénom:" />
                  <TextField fx:id="prenomtxt" prefHeight="36.0" prefWidth="230.0" styleClass="form-field" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label prefWidth="70.0" styleClass="form-label" text="Email:" />
                  <TextField fx:id="emailtxt" prefHeight="36.0" prefWidth="230.0" styleClass="form-field" />
               </children>
            </HBox>
            
            <HBox spacing="15.0" alignment="CENTER_LEFT">
               <children>
                  <Button mnemonicParsing="false" onAction="#clickajouter" prefHeight="40.0" prefWidth="100.0" styleClass="button-action" text="Ajouter" />
                  <Button mnemonicParsing="false" onAction="#clickupdate" prefHeight="40.0" prefWidth="100.0" text="Modifier" />
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#clickdelete" prefHeight="40.0" prefWidth="100.0" styleClass="button-delete" text="Supprimer" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <TextField fx:id="idtxt" prefHeight="36.0" prefWidth="150.0" promptText="Entrez ID" />
                  <Button mnemonicParsing="false" onAction="#clicksearch" prefHeight="40.0" prefWidth="100.0" text="Rechercher" />
               </children>
            </HBox>
         </children>
      </VBox>
      
      <TableView fx:id="table" layoutX="390.0" layoutY="20.0" prefHeight="460.0" prefWidth="390.0" AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" fixedCellSize="40.0">
        <columns>
          <TableColumn fx:id="columnid" prefWidth="60.0" text="ID" />
          <TableColumn fx:id="nomid" prefWidth="100.0" text="Nom" />
          <TableColumn fx:id="prenomid" prefWidth="100.0" text="Prénom" />
          <TableColumn fx:id="emailid" prefWidth="130.0" text="Email" />
        </columns>
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
      </TableView>
   </children>
</AnchorPane>
