<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.ClientController">
   <children>
      <VBox fx:id="idNomTfd" layoutX="7.0" layoutY="187.0" prefHeight="222.0" prefWidth="192.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Nom">
               <font>
                  <Font name="Arial Rounded MT Bold" size="12.0" />
               </font>
            </Text>
            <TextField fx:id="NOMTfd">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </TextField>
            <Text fx:id="PrenomTfd" strokeType="OUTSIDE" strokeWidth="0.0" text="Prenom">
               <font>
                  <Font name="Arial Rounded MT Bold" size="12.0" />
               </font>
            </Text>
            <TextField fx:id="PRENOMTfd">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </TextField>
            <Text fx:id="EmailTfd" strokeType="OUTSIDE" strokeWidth="0.0" text="Email">
               <font>
                  <Font name="Arial Rounded MT Bold" size="12.0" />
               </font>
            </Text>
            <TextField fx:id="EMAILTfd">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </TextField>
          <Button fx:id="AJOUTERTfd" mnemonicParsing="false" onAction="#ajouter" text="Ajouter">
               <font>
                  <Font name="Arial Rounded MT Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </VBox>
      <TableView fx:id="ClientTb" layoutX="290.0" layoutY="109.0" prefHeight="200.0" prefWidth="300.0">
        <columns>
          <TableColumn fx:id="IDCol" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="NOMCol" prefWidth="75.0" text="NOM" />
            <TableColumn fx:id="PRENOMCol" prefWidth="75.0" text="PRENOM" />
            <TableColumn fx:id="EMAILCol" prefWidth="75.0" text="EMAIL" />
        </columns>
      </TableView>
      <Text layoutX="258.0" layoutY="42.0" strokeType="OUTSIDE" strokeWidth="0.0" text="CRUD CLIENTS">
         <font>
            <Font size="22.0" />
         </font>
      </Text>
      <ButtonBar layoutX="290.0" layoutY="320.0" prefHeight="40.0" prefWidth="200.0">
        <buttons>
            <Button fx:id="ModifierBtn" layoutX="135.0" layoutY="17.0" mnemonicParsing="false" text="Modifier">
               <font>
                  <Font name="Arial Rounded MT Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="SuprimerBtn" layoutX="201.0" layoutY="17.0" mnemonicParsing="false" text="Supprimer">
               <font>
                  <Font name="Arial Rounded MT Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="ConsulterBtn" layoutX="135.0" layoutY="17.0" mnemonicParsing="false" text="Consulter">
               <font>
                  <Font name="Arial Rounded MT Bold" size="12.0" />
               </font>
            </Button>
        </buttons>
      </ButtonBar>
      <Button fx:id="RetourBtn" layoutX="30.0" layoutY="33.0" mnemonicParsing="false" text="Retour" />
   </children>
</AnchorPane>
