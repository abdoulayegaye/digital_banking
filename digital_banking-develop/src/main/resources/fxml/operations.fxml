<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/banking-style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.OperationController">
   <children>
      <VBox alignment="CENTER" layoutX="20.0" layoutY="20.0" prefHeight="460.0" prefWidth="760.0" spacing="30.0" styleClass="history-container">
         <children>
            <Label styleClass="history-title" text="Opérations Bancaires" />
            
            <Label styleClass="history-subtitle" text="Sélectionnez le type d'opération à effectuer">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Label>
            
            <HBox alignment="CENTER" spacing="50.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="15.0" styleClass="animated-panel">
                     <children>
                        <Label styleClass="form-label" text="Dépôt" />
                        <Button fx:id="depotBtn" mnemonicParsing="false" prefHeight="50.0" prefWidth="150.0" styleClass="button-action, animated-button" text="Effectuer un dépôt">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
                  
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="15.0" styleClass="animated-panel">
                     <children>
                        <Label styleClass="form-label" text="Retrait" />
                        <Button fx:id="retraitBtn" mnemonicParsing="false" prefHeight="50.0" prefWidth="150.0" styleClass="button-delete, animated-button" text="Effectuer un retrait">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
                  
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="15.0" styleClass="animated-panel">
                     <children>
                        <Label styleClass="form-label" text="Transfert" />
                        <Button fx:id="transfertBtn" mnemonicParsing="false" prefHeight="50.0" prefWidth="150.0" styleClass="pulse-button" text="Effectuer un transfert">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
            
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <Button fx:id="soldeBtn" mnemonicParsing="false" prefHeight="40.0" prefWidth="200.0" styleClass="button-secondary, animated-button" text="Consulter le solde" />
                  <Button fx:id="historiqueBtn" mnemonicParsing="false" prefHeight="40.0" prefWidth="200.0" styleClass="button-secondary, animated-button" text="Voir l'historique" />
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
