<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/banking-style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.DepotController">
   <children>
      <VBox layoutX="20.0" layoutY="20.0" prefHeight="460.0" prefWidth="760.0" spacing="20.0" styleClass="form-container">
         <children>
            <Label styleClass="panel-header" text="Gestion des Dépôts et Retraits" />
            
            <HBox spacing="20.0">
               <children>
                  <!-- Partie gauche : Recherche et informations client -->
                  <VBox spacing="15.0" prefWidth="350.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Label prefWidth="80.0" styleClass="form-label" text="ID Client:" />
                              <TextField fx:id="txtid" prefHeight="36.0" prefWidth="150.0" styleClass="form-field" />
                              <Button mnemonicParsing="false" onAction="#findclick" prefHeight="40.0" prefWidth="100.0" text="Rechercher" />
                           </children>
                        </HBox>
                        
                        <GridPane vgap="15.0" hgap="10.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <Label styleClass="form-label" text="N° Compte:" GridPane.rowIndex="0" />
                              <Label styleClass="form-label" text="Nom:" GridPane.rowIndex="1" />
                              <Label styleClass="form-label" text="Prénom:" GridPane.rowIndex="2" />
                              
                              <Label fx:id="accountidfield" styleClass="transaction-positive" text="?" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                              <Label fx:id="nomfield" text="?" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              <Label fx:id="prenomfield" text="?" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                           </children>
                           <padding>
                              <Insets top="20.0" />
                           </padding>
                        </GridPane>
                     </children>
                  </VBox>
                  
                  <!-- Partie droite : Solde et opérations -->
                  <VBox spacing="15.0" prefWidth="350.0" alignment="TOP_CENTER">
                     <children>
                        <Label styleClass="form-label" text="Solde actuel" />
                        <Label fx:id="balancefield" styleClass="account-balance" text="?" />
                        
                        <VBox spacing="10.0" alignment="CENTER">
                           <children>
                              <Label styleClass="form-label" text="Montant" />
                              <TextField fx:id="txtdepot" prefHeight="50.0" prefWidth="200.0" styleClass="form-field" />
                           </children>
                           <padding>
                              <Insets top="20.0" />
                           </padding>
                        </VBox>
                        
                        <HBox spacing="20.0" alignment="CENTER">
                           <children>
                              <Button mnemonicParsing="false" onAction="#okclick" prefHeight="40.0" prefWidth="120.0" styleClass="button-action" text="DÉPÔT" />
                              <Button mnemonicParsing="false" onAction="#retraitclick" prefHeight="40.0" prefWidth="120.0" styleClass="button-delete" text="RETRAIT" />
                           </children>
                           <padding>
                              <Insets top="20.0" />
                           </padding>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
