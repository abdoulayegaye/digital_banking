<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/banking-style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.HistoriqueController">
   <children>
      <VBox alignment="CENTER" layoutX="20.0" layoutY="20.0" prefHeight="460.0" prefWidth="760.0" spacing="30.0" styleClass="history-container">
         <children>
            <Label styleClass="history-title" text="Historiques des Opérations" />
            
            <Label styleClass="history-subtitle" text="Sélectionnez le type d'opération à consulter">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Label>
            
            <HBox alignment="CENTER" spacing="50.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="15.0" styleClass="animated-panel">
                     <children>
                        <Label styleClass="form-label" text="Historique des dépôts" />
                        <Button mnemonicParsing="false" onAction="#depotclick" prefHeight="50.0" prefWidth="150.0" styleClass="button-action, animated-button" text="Dépôts">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
                  
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="15.0" styleClass="animated-panel">
                     <children>
                        <Label styleClass="form-label" text="Historique des retraits" />
                        <Button mnemonicParsing="false" onAction="#retraitclick" prefHeight="50.0" prefWidth="150.0" styleClass="button-delete, animated-button" text="Retraits">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
                  
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="15.0" styleClass="animated-panel">
                     <children>
                        <Label styleClass="form-label" text="Historique des transferts" />
                        <Button mnemonicParsing="false" onAction="#transfertclick" prefHeight="50.0" prefWidth="150.0" styleClass="pulse-button" text="Transferts">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
