<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/banking-style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.releverController">
   <children>
      <VBox alignment="CENTER" layoutX="20.0" layoutY="20.0" prefHeight="360.0" prefWidth="560.0" spacing="20.0" styleClass="history-container">
         <children>
            <Label styleClass="history-title" text="Relevé Bancaire" />
            
            <VBox alignment="CENTER" spacing="15.0" styleClass="history-filter-box, animated-panel">
               <children>
                  <Label styleClass="history-subtitle" text="Générer un relevé de compte" />
                  
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Label prefWidth="80.0" styleClass="form-label" text="ID Client:" />
                        <TextField fx:id="txtlab" prefHeight="36.0" prefWidth="250.0" styleClass="form-field" promptText="Entrez l'ID client" />
                        <Button mnemonicParsing="false" onAction="#clickfind" prefHeight="40.0" prefWidth="100.0" styleClass="animated-button" text="Rechercher" />
                     </children>
                  </HBox>
                  
                  <Button mnemonicParsing="false" onAction="#clickgen" prefHeight="50.0" prefWidth="200.0" styleClass="pulse-button" text="Générer le relevé">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
