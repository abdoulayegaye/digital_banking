<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/banking-style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.HdepotController">
   <children>
      <VBox layoutX="20.0" layoutY="20.0" prefHeight="460.0" prefWidth="760.0" spacing="20.0" styleClass="history-container">
         <children>
            <Label styleClass="history-title" text="Historique des Dépôts" />
            
            <HBox spacing="20.0">
               <children>
                  <!-- Partie gauche : Filtres et recherche -->
                  <VBox spacing="15.0" prefWidth="200.0" styleClass="history-filter-box, animated-panel">
                     <children>
                        <Label styleClass="history-subtitle" text="Filtres" />
                        
                        <VBox spacing="10.0">
                           <children>
                              <Label styleClass="form-label" text="ID Client:" />
                              <TextField fx:id="txtlab" prefHeight="36.0" styleClass="form-field" promptText="Entrez l'ID client" />
                           </children>
                        </VBox>
                        
                        <Button mnemonicParsing="false" onAction="#clickfind" prefHeight="40.0" prefWidth="160.0" styleClass="animated-button" text="Rechercher">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                        
                        <Button mnemonicParsing="false" onAction="#clickalldepot" prefHeight="40.0" prefWidth="160.0" styleClass="pulse-button" text="Tous les dépôts">
                           <VBox.margin>
                              <Insets top="20.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </VBox>
                  
                  <!-- Partie droite : Tableau des résultats -->
                  <TableView fx:id="table" prefHeight="400.0" prefWidth="520.0" styleClass="history-table">
                    <columns>
                      <TableColumn fx:id="id" prefWidth="50.0" text="ID" />
                      <TableColumn fx:id="acc_id" prefWidth="100.0" text="N° Compte" />
                      <TableColumn fx:id="cust_id" prefWidth="80.0" text="ID Client" />
                      <TableColumn fx:id="solde" prefWidth="100.0" text="Montant" />
                      <TableColumn fx:id="date" prefWidth="180.0" text="Date" />
                    </columns>
                    <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                  </TableView>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
