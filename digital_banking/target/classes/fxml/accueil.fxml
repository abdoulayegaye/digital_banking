<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.banking.digitalbankingproject.controller.AccueilController"
            stylesheets="@../styles/application.css">
    
    <!-- Header -->
    <top>
        <HBox styleClass="header" alignment="CENTER">
            <Label text="Digital Banking" styleClass="header-title"/>
        </HBox>
    </top>
    
    <!-- Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="30" styleClass="content-area">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>
            
            <!-- Welcome Message -->
            <VBox alignment="CENTER" spacing="15">
                <Label text="Bienvenue dans votre espace bancaire" styleClass="welcome-header"/>
                <Text text="Gérez vos comptes et effectuez vos opérations en toute simplicité" 
                      styleClass="welcome-text" textAlignment="CENTER"/>
            </VBox>
            
            <!-- Menu Cards -->
            <HBox alignment="CENTER" spacing="30">
                <!-- Clients Card -->
                <VBox styleClass="card" alignment="CENTER" spacing="15" maxWidth="250" maxHeight="200">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
                        <Image url="@../images/clients.png"/>
                    </ImageView>
                    <Label text="Gestion des Clients" styleClass="label-header"/>
                    <Button fx:id="btnClients" text="Accéder" styleClass="button"/>
                </VBox>
                
                <!-- Comptes Card -->
                <VBox styleClass="card" alignment="CENTER" spacing="15" maxWidth="250" maxHeight="200">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
                        <Image url="@../images/accounts.png"/>
                    </ImageView>
                    <Label text="Gestion des Comptes" styleClass="label-header"/>
                    <Button fx:id="btnComptes" text="Accéder" styleClass="button"/>
                </VBox>
                
                <!-- Operations Card -->
                <VBox styleClass="card" alignment="CENTER" spacing="15" maxWidth="250" maxHeight="200">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
                        <Image url="@../images/operations.png"/>
                    </ImageView>
                    <Label text="Opérations Bancaires" styleClass="label-header"/>
                    <Button fx:id="btnOperations" text="Accéder" styleClass="button"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
    
    <!-- Footer -->
    <bottom>
        <HBox styleClass="header" alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label text=" 2025 Digital Banking - Tous droits réservés" textFill="white"/>
        </HBox>
    </bottom>
    
</BorderPane>
