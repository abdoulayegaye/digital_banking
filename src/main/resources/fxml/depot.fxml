<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.DepotController">
    <children>
        <Label layoutX="14.0" layoutY="14.0" text="Compte"/>
        <ComboBox fx:id="comboComptes" layoutX="14.0" layoutY="34.0" prefWidth="200.0"/>
        <Label layoutX="14.0" layoutY="74.0" text="Montant"/>
        <TextField fx:id="textMontant" layoutX="14.0" layoutY="94.0" prefWidth="200.0"/>
        <Button fx:id="btnDepot" layoutX="14.0" layoutY="134.0" mnemonicParsing="false" onAction="#effectuerDepot" text="Déposer"/>
        <Button fx:id="btnRetour" layoutX="14.0" layoutY="174.0" mnemonicParsing="false" onAction="#retourGestionOperations">

            <text>Retour</text>
        </Button>
    </children>
</AnchorPane>
