<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.banking.digitalbankingproject.controller.ListeClientController">

    <children>
        <!-- TableView pour afficher la liste des clients -->
        <TableView fx:id="tableView" layoutX="20.0" layoutY="50.0" prefHeight="300.0" prefWidth="460.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNom" prefWidth="120.0" text="Nom" />
                <TableColumn fx:id="colPrenom" prefWidth="120.0" text="Prénom" />
                <TableColumn fx:id="colEmail" prefWidth="170.0" text="Email" />
            </columns>
        </TableView>

        <!-- Champ de recherche -->
        <TextField fx:id="recherche" layoutX="300.0" layoutY="10.0" promptText="Rechercher..." />

        <!-- Bouton Modifier -->
        <Button fx:id="btnModifier" layoutX="500.0" layoutY="100.0" mnemonicParsing="false"
                onAction="#btnModifier" prefHeight="30.0" prefWidth="100.0"
                style="-fx-background-color: blue; -fx-text-fill: white;" text="Modifier">
            <font><Font size="14.0" /></font>
        </Button>

        <!-- Bouton Supprimer -->
        <Button fx:id="btnSupprimer" layoutX="500.0" layoutY="150.0" mnemonicParsing="false"
                onAction="#btnSupprimer" prefHeight="30.0" prefWidth="100.0"
                style="-fx-background-color: red; -fx-text-fill: white;" text="Supprimer">
            <font><Font size="14.0" /></font>
        </Button>

        <!-- Bouton Retour -->
        <Button fx:id="btnRetour" layoutX="20.0" layoutY="10.0" mnemonicParsing="false"
                onAction="#btnRetour" prefHeight="30.0" prefWidth="80.0"
                text="Retour" />
    </children>

</AnchorPane>
