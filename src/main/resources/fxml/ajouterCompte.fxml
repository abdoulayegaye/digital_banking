<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.banking.digitalbankingproject.controller.AjouterCompteController">
    <children>
        <VBox alignment="CENTER" spacing="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="Ajouter Compte" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtSolde" promptText="Solde du compte"/>
                <CheckBox fx:id="chkActif" text="Compte Actif"/>
                <!-- Nouveaux champs pour le client -->
                <TextField fx:id="txtClientNom" promptText="Nom du Client"/>
                <TextField fx:id="txtClientEmail" promptText="Email du Client"/>
                <Button fx:id="btnAjouter" text="Ajouter" onAction="#ajouterCompte"/>
                <Button fx:id="btnRetour" text="Retour" onAction="#retourGestionComptes"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
