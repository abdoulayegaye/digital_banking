<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="293.0" prefWidth="230.0" spacing="20" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.javafx.controllers.consultationController">
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Consulter le Solde" />

    <!-- Champ de saisie pour le numéro de compte -->
    <TextField fx:id="numeroCompteField" promptText="Numéro de compte" />

    <!-- Bouton pour consulter le solde -->
    <Button onAction="#consulterSolde" style="-fx-background-color: #132A13;" text="Consulter" textFill="WHITE">
      <font>
         <Font name="System Bold" size="16.0" />
      </font></Button>

    <!-- Label pour afficher le solde -->
    <Label fx:id="soldeLabel" style="-fx-font-size: 16px;" text="Solde : " />
</VBox>
