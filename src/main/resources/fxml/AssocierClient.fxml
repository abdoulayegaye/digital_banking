<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane fx:id="associerClientPane" prefHeight="200.0" prefWidth="468.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.AssocierClientController">
    <children>
        <HBox layoutX="10.0" layoutY="10.0">
            <Button fx:id="btnRetour" onAction="#retourGestionComptes" style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/retour.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <Label layoutX="20.0" layoutY="40.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Associer un Client" />

        <Label layoutX="20.0" layoutY="80.0" text="Client:" />
        <ComboBox fx:id="comboClient" layoutX="100.0" layoutY="80.0" prefWidth="200.0" />

        <Button fx:id="btnAssocier" layoutX="154.0" layoutY="122.0" onAction="#associerClient" text="Associer" />
        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="312.0" layoutY="25.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/icone%20associer%20compte%20a%20client.png" />
            </image>
        </ImageView>
    </children>
</AnchorPane>