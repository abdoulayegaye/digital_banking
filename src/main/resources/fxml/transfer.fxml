<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #f4f6f7, #e0e0e0);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.TransferController">

    <!-- Titre principal -->
    <Label layoutX="205.0" layoutY="44.0" text="VIREMENT BANCAIRE" textFill="#0f0cc6">
        <font>
            <Font name="Arial Bold" size="42.0" />
        </font>
        <effect>
            <DropShadow color="#00000033" radius="10.0" />
        </effect>
    </Label>

    <!-- Section Formulaire -->
    <AnchorPane layoutX="50.0" layoutY="120.0" prefHeight="350.0" prefWidth="800.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 30;">

        <!-- Compte Source -->
        <Label layoutX="23.0" layoutY="46.0" text="COMPTE SOURCE :" textFill="#444444">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <ComboBox fx:id="sourceCombo" layoutX="253.0" layoutY="36.0" prefHeight="40.0" prefWidth="300.0" promptText="Sélectionner le compte source" style="-fx-background-radius: 8; -fx-font-size: 14px; -fx-background-color: #f9f9f9; -fx-border-color: #3498db; -fx-border-radius: 8; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#00000033" radius="5.0" />
            </effect>
        </ComboBox>

        <!-- Compte Destination -->
        <Label layoutX="23.0" layoutY="116.0" text="COMPTE DESTINATION :" textFill="#444444">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <ComboBox fx:id="destinationCombo" layoutX="253.0" layoutY="106.0" prefHeight="40.0" prefWidth="300.0" promptText="Sélectionner le compte destination" style="-fx-background-radius: 8; -fx-font-size: 14px; -fx-background-color: #f9f9f9; -fx-border-color: #3498db; -fx-border-radius: 8; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#00000033" radius="5.0" />
            </effect>
        </ComboBox>

        <!-- Montant -->
        <Label layoutX="23.0" layoutY="186.0" text="MONTANT :" textFill="#444444">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <TextField fx:id="montantTfd" layoutX="253.0" layoutY="176.0" prefHeight="40.0" prefWidth="300.0" promptText="Saisir le montant" style="-fx-background-radius: 8; -fx-font-size: 14px; -fx-background-color: #f9f9f9; -fx-border-color: #3498db; -fx-border-radius: 8;">
            <effect>
                <DropShadow color="#00000033" radius="5.0" />
            </effect>
        </TextField>

        <!-- Boutons -->
        <Button layoutX="153.0" layoutY="260.0" onAction="#effectuerTransfer" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #0f0cc6; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 8; -fx-cursor: hand;" text="Effectuer le transfert">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
            <effect>
                <DropShadow color="#00000033" radius="8.0" />
            </effect>
        </Button>

        <Button layoutX="403.0" layoutY="260.0" onAction="#retour" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 8; -fx-cursor: hand;" text="Retour">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
            <effect>
                <DropShadow color="#00000033" radius="8.0" />
            </effect>
        </Button>
    </AnchorPane>

</AnchorPane>
