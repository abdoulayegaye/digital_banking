<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:id="modifierClientPane" prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="com.banking.digitalbankingproject.controller.ModifierClientController">
    <children>

        <Label layoutX="20.0" layoutY="40.0" text="Modifier un Client" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label layoutX="20.0" layoutY="80.0" text="Nom:"/>
        <TextField fx:id="txtNom" layoutX="100.0" layoutY="80.0" prefWidth="200.0"/>

        <Label layoutX="20.0" layoutY="120.0" text="Prénom:"/>
        <TextField fx:id="txtPrenom" layoutX="100.0" layoutY="120.0" prefWidth="200.0"/>

        <Label layoutX="20.0" layoutY="160.0" text="Email:"/>
        <TextField fx:id="txtEmail" layoutX="100.0" layoutY="160.0" prefWidth="200.0"/>

        <Button fx:id="btnModifier" layoutX="100.0" layoutY="200.0" text="Modifier Client" onAction="#modifierClient"/>
    </children>
</AnchorPane>