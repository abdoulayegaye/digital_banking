<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane fx:id="supprimerClientPane" minHeight="150.0" minWidth="300.0" prefHeight="200.0" prefWidth="400.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.banking.digitalbankingproject.controller.SupprimerClientController">
    <children>
        <HBox layoutX="10.0" layoutY="10.0">
            <Button fx:id="btnRetour" onAction="#retourGestionClients" style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../../../../../../../Users/CnG/Pictures/fleche%20de%20retour.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <Label fx:id="lblConfirmation" layoutX="50.0" layoutY="50.0" prefHeight="30.0" prefWidth="300.0" text="Voulez-vous vraiment supprimer ce client ?" />
        <HBox layoutX="100.0" layoutY="100.0" spacing="20.0">
            <children>
                <Button fx:id="btnOui" prefHeight="40.0" prefWidth="80.0" text="Oui" />
                <Button fx:id="btnNon" prefHeight="40.0" prefWidth="80.0" text="Non" />
            </children>
        </HBox>
    </children>
</AnchorPane>
