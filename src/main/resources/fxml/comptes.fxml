               </font>
            </Button>
         </children>
      </GridPane>
      <TableView fx:id="tableView" layoutX="286.0" layoutY="63.0" prefHeight="161.0" prefWidth="303.0">
        <columns>
          <TableColumn fx:id="numeroCompteCol" prefWidth="75.0" text="Numéro compte" />
          <TableColumn fx:id="soldeCol" prefWidth="75.0" text="Solde" />
            <TableColumn fx:id="dateOuvertureCol" prefWidth="75.0" text="Date ouverture" />
            <TableColumn fx:id="clientCol" prefWidth="75.0" text="Client" />
        </columns>
      </TableView>
      <Button fx:id="consulterSolde" layoutX="286.0" layoutY="233.0" mnemonicParsing="false" onAction="#consulterSoldeBtn" style="-fx-background-color: blue;" text="Consulter Solde" textFill="WHITE" />
      <Button fx:id="fermerCompteBtn" layoutX="397.0" layoutY="233.0" mnemonicParsing="false" onAction="#fermerCompteBtn" style="-fx-background-color: blue;" text="Fermer Compte" textFill="WHITE" />
