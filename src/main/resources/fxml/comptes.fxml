<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.banking.digitalbankingproject.controller.CompteController"
            prefHeight="400.0" prefWidth="800.0">

    <HBox spacing="20" alignment="CENTER" prefWidth="800.0" prefHeight="400.0">

        <!-- Section Gauche : TableView -->
        <VBox spacing="10" prefWidth="400.0" prefHeight="380.0">
            <Button fx:id="btnRetourAccueil" text="Retour à l'accueil" onAction="#retourAccueil"/>
            <TableView fx:id="tableComptes" prefHeight="300.0" prefWidth="350.0">
                <columns>
                    <TableColumn fx:id="colNumCompte" text="Numéro de Compte" prefWidth="100"/>
                    <TableColumn fx:id="colSolde" text="Solde" prefWidth="80"/>
                    <TableColumn fx:id="colDateOuverture" text="Date" prefWidth="80"/>
                    <TableColumn fx:id="colClient" text="Client" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Section Droite : Formulaire -->
        <VBox alignment="CENTER_LEFT" spacing="10" layoutX="320.0" layoutY="10.0" style="-fx-background-color: #f0f0f0; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Numéro de Compte"/>
            <TextField fx:id="numCompteField" editable="false" prefWidth="200.0"/>

            <Label text="Solde Initial"/>
            <TextField fx:id="soldeField" prefWidth="200.0"/>

            <Label text="Date d'ouverture"/>
            <DatePicker fx:id="dateOuverturePicker" prefWidth="200.0"/>

            <Label text="Client"/>
            <ComboBox fx:id="clientComboBox" prefWidth="200.0"/>

            <!-- Boutons d'action -->
            <VBox spacing="10" alignment="CENTER" layoutX="320.0" layoutY="220.0">
                <Button fx:id="btnAjouter" text="Créer le compte" onAction="#ajouterCompte" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button fx:id="btnFermerCompte" text="Fermer le compte" onAction="#fermerCompte" style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
            </VBox>
        </VBox>

    </HBox>

</AnchorPane>
