<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.CompteController">
   <children>
      <VBox alignment="CENTER" layoutX="43.0" layoutY="49.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER" maxHeight="50.0" prefHeight="100.0" prefWidth="200.0" spacing="5.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Client :" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="clientCbb" prefHeight="25.0" prefWidth="460.0" HBox.hgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </HBox>
                  <HBox alignment="CENTER" maxHeight="50.0" prefHeight="100.0" prefWidth="200.0" spacing="32.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Numero Compte :" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="numeroTfd" disable="true" promptText="Le numero de compte" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="20.0" layoutY="185.0" maxHeight="50.0" prefHeight="100.0" prefWidth="200.0" spacing="32.0">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Solde :" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="soldeTfd" prefHeight="25.0" prefWidth="444.0" promptText="Le solde" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="213.0" maxHeight="50.0" prefHeight="100.0" prefWidth="200.0" spacing="32.0">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Date d'ouverture" HBox.hgrow="ALWAYS" />
                        <DatePicker fx:id="dateOuvertureDp" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="50.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="ajouterBtn" mnemonicParsing="false" onAction="#add" styleClass="btn-info" text="Ajouter" />
                  <Button fx:id="consulterBtn" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#getcons" styleClass="btn-secondary" text="Consulter" />
                  <Button fx:id="fermerBtn" layoutX="62.0" layoutY="10.0" mnemonicParsing="false" onAction="#close" styleClass="btn-danger" text="Fermer" />
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="compteTb" onMouseClicked="#getData" prefHeight="90.0" prefWidth="529.0" HBox.hgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="numCol" prefWidth="179.0" text="Num Compte" />
                      <TableColumn fx:id="clientCol" prefWidth="128.0" text="Client" />
                        <TableColumn fx:id="balanceCol" prefWidth="130.0" text="Solde" />
                        <TableColumn fx:id="etatCol" prefWidth="142.0" text="Etat" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
