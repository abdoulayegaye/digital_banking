<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.CompteController">
   <children>
      <TextField layoutX="226.0" prefHeight="36.0" prefWidth="147.0" promptText="ESPACE COMPTE" style="-fx-background-color: blue;">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </TextField>
      <Button fx:id="retourAccueilBtn" layoutY="1.0" mnemonicParsing="false" onAction="#retourAccueilBtn" style="-fx-background-color: blue;" text="&lt;--Retour" textFill="WHITE" />
      <GridPane layoutX="14.0" layoutY="63.0" prefHeight="98.0" prefWidth="256.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="127.33334350585938" minWidth="10.0" prefWidth="127.33334350585938" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="140.0" minWidth="10.0" prefWidth="128.66665649414062" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <TextField fx:id="numeroCompteField" promptText="Numéro de compte" />
            <TextField fx:id="soldeField" promptText="Solde Initiale" GridPane.columnIndex="1" />
            <DatePicker fx:id="dateOuverturePicker" promptText="date d'ouverture" GridPane.rowIndex="1" />
            <ComboBox fx:id="clientComboBox" prefWidth="150.0" promptText="client associée" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button fx:id="creerCompteBtn" mnemonicParsing="false" onAction="#creerCompteBtn" prefHeight="25.0" prefWidth="131.0" style="-fx-background-color: blue;" text="Créer un compte" textFill="WHITE" GridPane.rowIndex="2">
               <font>
