<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="857.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.CompteController">
   <children>
      <Label layoutX="79.0" layoutY="29.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestion des Comptes" />
      <Label layoutX="47.0" layoutY="75.0" text="Rechercher :" />
      <TextField fx:id="txtRecherche" layoutX="133.0" layoutY="71.0" prefHeight="25.0" prefWidth="221.0" promptText="Entrez un nom ou un num de compte" />
      <Button layoutX="369.0" layoutY="476.0" onAction="#ajouter_compte" prefHeight="30.0" prefWidth="100.0" text="Ajouter" />
      <Button layoutX="22.0" layoutY="476.0" mnemonicParsing="false" onAction="#Retour_Accueil" prefHeight="30.0" prefWidth="100.0" text="Return" />
      <TableView fx:id="tableViewComptes" layoutX="22.0" layoutY="116.0" prefHeight="341.0" prefWidth="453.0">
         <columns>
            <TableColumn fx:id="numC" prefWidth="136.0" text="Numero de compte" />
            <TableColumn fx:id="soldeC" prefWidth="103.0" text="Solde" />
            <TableColumn fx:id="dateC" prefWidth="117.0" text="Date douverture" />
            <TableColumn fx:id="cliC" prefWidth="97.0" text="Client">
               <columns>
                  <TableColumn fx:id="nomCliC" prefWidth="75.0" text="Nom" />
               </columns></TableColumn>
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Pane fx:id="form_compte" layoutX="488.0" layoutY="116.0" prefHeight="341.0" prefWidth="275.0" visible="false">
         <children>
            <Text layoutX="88.0" layoutY="33.0" strokeType="OUTSIDE" strokeWidth="0.0" text="AJOUTER UN COMPTES" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Text>
            <Text layoutX="35.0" layoutY="221.0" strokeType="OUTSIDE" strokeWidth="0.0" text=" SOLDE :">
               <font>
                  <Font size="14.0" />
               </font>
            </Text>
            <TextField fx:id="solde" layoutX="112.0" layoutY="204.0" promptText="Entrez votre nom" />
            <Button layoutX="103.0" layoutY="273.0" mnemonicParsing="false" onAction="#valider_compte" text="VALIDER" />
            <Text fx:id="client" layoutX="35.0" layoutY="95.0" strokeType="OUTSIDE" strokeWidth="0.0" text="NOM">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Text>
         </children>
      </Pane>
   </children>
</AnchorPane>
