<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: #2c3e50;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.banking.digitalbankingproject.controller.CompteController">
    <children>
        <!-- Panneau principal -->
        <AnchorPane layoutX="200.0" prefHeight="500.0" prefWidth="600.0" style="-fx-background-color: #ecf0f1;">
            <children>
                <!-- Titre -->
                <Text layoutX="150.0" layoutY="50.0" text="GESTION DES COMPTES" strokeType="OUTSIDE" strokeWidth="0.0">
                    <font>
                        <Font name="System Bold Italic" size="28.0" />
                    </font>
                </Text>

                <!-- Champs de saisie -->
                <Text layoutX="30.0" layoutY="100.0" text="NUMÉRO" strokeType="OUTSIDE" strokeWidth="0.0">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>
                <TextField fx:id="numeroField" layoutX="30.0" layoutY="110.0" prefHeight="30.0" prefWidth="250.0" />

                <Text layoutX="30.0" layoutY="160.0" text="SOLDE" strokeType="OUTSIDE" strokeWidth="0.0">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>
                <TextField fx:id="soldeField" layoutX="30.0" layoutY="170.0" prefHeight="30.0" prefWidth="250.0" />

                <Text layoutX="30.0" layoutY="220.0" text="DATE OUVERTURE" strokeType="OUTSIDE" strokeWidth="0.0">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>
                <DatePicker fx:id="dateOuvertureField" layoutX="30.0" layoutY="230.0" prefHeight="30.0" prefWidth="250.0" />

                <Text layoutX="30.0" layoutY="280.0" text="CLIENT" strokeType="OUTSIDE" strokeWidth="0.0">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>
                <ComboBox fx:id="clientComboBox" layoutX="30.0" layoutY="290.0" prefHeight="30.0" prefWidth="250.0" />

                <!-- Boutons -->
                <Button fx:id="creerBtn" layoutX="30.0" layoutY="340.0" onAction="#creerCompte" prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 8;" text="CRÉER" />
                <Button fx:id="consulterBtn" layoutX="140.0" layoutY="340.0" onAction="#consulterSolde" prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-background-radius: 8;" text="CONSULTER" />
                <Button fx:id="fermerBtn" layoutX="250.0" layoutY="340.0" onAction="#fermerCompte" prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8;" text="FERMER" />
                <Button fx:id="pdfBtn" layoutX="360.0" layoutY="340.0" onAction="#genererPdf" prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8;" text="PDF" />

                <!-- TableView pour afficher les comptes -->
                <TableView fx:id="compteTable" layoutX="30.0" layoutY="400.0" prefHeight="90.0" prefWidth="540.0">
                    <columns>
                        <TableColumn fx:id="numeroCol" prefWidth="120.0" text="Numéro" />
                        <TableColumn fx:id="soldeCol" prefWidth="100.0" text="Solde" />
                        <TableColumn fx:id="dateCol" prefWidth="120.0" text="Date Ouverture" />
                        <TableColumn fx:id="clientCol" prefWidth="200.0" text="Client" />
                    </columns>
                </TableView>
            </children>
        </AnchorPane>

        <!-- Image à gauche -->
        <ImageView fitHeight="500.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/compte-image.jpg" />
            </image>
        </ImageView>
    </children>
</AnchorPane>