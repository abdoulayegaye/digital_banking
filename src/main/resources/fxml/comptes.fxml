<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.banking.digitalbankingproject.controller.CompteController"
      stylesheets="@../csss/style.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label styleClass="title-label" text="Gestion des Comptes"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Client:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="comboClient" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Solde Initial:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtSoldeInitial" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox spacing="10.0">
        <Button fx:id="btnCreer" styleClass="action-button" text="Créer Compte" style="-fx-background-color: green; color: white; border: none; padding: 10px 20px; cursor: pointer"/>
        <Button fx:id="btnFermer" styleClass="action-button" text="Fermer Compte" style="-fx-background-color: red; color: white; border: none; padding: 10px 20px; cursor: pointer"/>
    </HBox>

    <TableView fx:id="tableComptes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumero" text="Numéro" prefWidth="150"/>
            <TableColumn fx:id="colSolde" text="Solde" prefWidth="100"/>
            <TableColumn fx:id="colDateCreation" text="Date de Création" prefWidth="150"/>
            <TableColumn fx:id="colClient" text="Client" prefWidth="200"/>
        </columns>
    </TableView>
</VBox>
