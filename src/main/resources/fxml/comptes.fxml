<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="comptePane" prefWidth="800.0" prefHeight="600.0" minWidth="600.0" minHeight="400.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.CompteController">
    <children>
        <HBox alignment="CENTER" spacing="20">
            <children>
                <Button fx:id="btnRetour" text="Retour" />
                <Button fx:id="btnActualiser" text="Actualiser" />
                <Label fx:id="lblComptes" prefWidth="700.0" prefHeight="40.0" text="Comptes" />
            </children>
        </HBox>
        <TableView fx:id="tableComptes" prefWidth="700.0" prefHeight="400.0" />
        <HBox alignment="CENTER" spacing="20">
            <children>
                <Button fx:id="btnAjouterCompte" prefWidth="150.0" prefHeight="50.0" text="Ajouter" />
                <Button fx:id="btnModifierCompte" prefWidth="150.0" prefHeight="50.0" text="Modifier" />
                <Button fx:id="btnSupprimerCompte" prefWidth="150.0" prefHeight="50.0" text="Supprimer" />
            </children>
        </HBox>
    </children>
</VBox>