<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.CompteController">
   <children>
      <ImageView fitHeight="644.0" fitWidth="856.0" layoutX="-2.0" layoutY="-17.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/arriere_plan2.jpg" />
         </image>
      </ImageView>
      <ButtonBar layoutX="111.0" layoutY="434.0" prefHeight="53.0" prefWidth="406.0">
        <buttons>
            <Button fx:id="btnModifierCompte" layoutX="135.0" layoutY="17.0" mnemonicParsing="false" onAction="#allerModifierCompte" text="Modifier">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <effect>
                  <DropShadow>
                     <color>
                        <Color red="0.9674066305160522" green="1.0" />
                     </color>
                  </DropShadow>
               </effect>
            </Button>
            <Button fx:id="btnSupprimerCompte" layoutX="49.0" layoutY="17.0" mnemonicParsing="false" onAction="#allerSupprimerCompte" text="Supprimer">
               <effect>
                  <DropShadow>
                     <color>
                        <Color red="1.0" />
                     </color>
                  </DropShadow>
               </effect>
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnRefresh" layoutX="311.0" layoutY="22.0" mnemonicParsing="false" onAction="#rafraichirComptes" text="Actualiser">
               <effect>
                  <DropShadow>
                     <color>
                        <Color green="0.9166666865348816" blue="1.0" />
                     </color>
                  </DropShadow>
               </effect>
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
          <Button fx:id="btnAjouterCompte" mnemonicParsing="false" onAction="#allerAjouterCompte" text="Création">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <effect>
                  <DropShadow>
                     <color>
                        <Color red="0.05000000074505806" green="1.0" />
                     </color>
                  </DropShadow>
               </effect>
            </Button>
        </buttons>
         <padding>
            <Insets right="10.0" />
         </padding>
      </ButtonBar>
      <ImageView fitHeight="118.0" fitWidth="104.0" layoutX="736.0" layoutY="509.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/gestion compte.png" />
         </image>
         <effect>
            <DropShadow>
               <color>
                  <Color red="1.0" green="1.0" blue="1.0" />
               </color>
            </DropShadow>
         </effect>
      </ImageView>
      <TableView fx:id="tableViewComptes" layoutX="24.0" layoutY="91.0" onMouseClicked="#getData" opacity="0.92" prefHeight="327.0" prefWidth="580.0">
        <columns>
          <TableColumn fx:id="colNumero" prefWidth="96.66665649414062" text="Numero" />
          <TableColumn fx:id="colClient" prefWidth="192.6666259765625" text="Client" />
            <TableColumn fx:id="colSolde" prefWidth="109.3333740234375" text="Solde" />
            <TableColumn fx:id="colDate" minWidth="6.0" prefWidth="180.66668701171875" text="Date de création" />
        </columns>
      </TableView>
      <Text fill="WHITE" layoutX="326.0" layoutY="53.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gestion des comptes" wrappingWidth="350.314453125">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Text>
      <Text fill="WHITE" layoutX="614.0" layoutY="117.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ajouter un compte">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Text>
      <VBox layoutX="614.0" layoutY="133.0" prefHeight="259.0" prefWidth="212.0">
         <children>
            <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Numéro">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Text>
            <TextField fx:id="numeroComptes" onAction="#allerNumeroComptes" promptText="Votre numéro ici">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </TextField>
            <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Client">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Text>
            <TextField fx:id="clientComptes" onAction="#allerClientComptes">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </TextField>
            <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Solde">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Text>
            <TextField fx:id="soldeComptes" onAction="#allerSoldeComptes" promptText="Votre solde ici">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </TextField>
            <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Date d'ouverture">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Text>
            <DatePicker fx:id="dateComptes" onAction="#allerDateComptes" promptText="Date d'ouverture ici">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </DatePicker>
         </children>
      </VBox>
      <Button fx:id="cleanComptes" layoutX="614.0" layoutY="406.0" mnemonicParsing="false" onAction="#allezCleanComptes" text="Clean">
         <font>
            <Font name="System Bold Italic" size="10.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
