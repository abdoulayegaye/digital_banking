<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="557.0" prefWidth="1171.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.CompteController">
    <children>
        <!-- Titre principal -->
        <Button layoutX="449.0" layoutY="9.0" mnemonicParsing="false" prefHeight="50.0" prefWidth="438.0" style="-fx-background-color: #2c3e50;" text="GESTION DES COMPTES" textAlignment="CENTER" textFill="white">
            <font>
                <Font size="23.0" />
            </font>
        </Button>

        <!-- Formulaire de création de compte -->
        <Text layoutX="50.0" layoutY="150.0" style="-fx-font-size: 16;" text="Client :" />
        <ComboBox fx:id="clientCombo" layoutX="50.0" layoutY="160.0" prefWidth="300.0" promptText="Sélectionnez un client" />

        <Text layoutX="50.0" layoutY="220.0" style="-fx-font-size: 16;" text="Numéro de compte :" />
        <TextField fx:id="numCompteTfd" disable="true" layoutX="50.0" layoutY="230.0" prefWidth="300.0" promptText="Généré automatiquement" />

        <Text layoutX="50.0" layoutY="290.0" style="-fx-font-size: 16;" text="Date d'ouverture :" />
        <DatePicker fx:id="dateOuverturePicker" layoutX="50.0" layoutY="300.0" prefWidth="300.0" />

        <Text layoutX="50.0" layoutY="360.0" style="-fx-font-size: 16;" text="Solde initial :" />
        <TextField fx:id="soldeTfd" layoutX="50.0" layoutY="370.0" prefWidth="300.0" promptText="0.0" />

        <!-- Tableau des comptes -->
        <TableView fx:id="compteTable" layoutX="399.0" layoutY="100.0" prefHeight="400.0" prefWidth="594.0">
            <columns>
                <TableColumn fx:id="numCol" prefWidth="148.0" text="N° Compte" />
                <TableColumn fx:id="soldeCol" prefWidth="130.0" text="Solde" />
                <TableColumn fx:id="dateCol" prefWidth="170.0" text="Date Ouverture" />
                <TableColumn fx:id="clientCol" prefWidth="144.0" text="Client" />
            </columns>
        </TableView>

        <!-- Boutons d'actions -->
        <ButtonBar layoutX="50.0" layoutY="450.0" prefHeight="40.0" prefWidth="300.0">
            <buttons>
                <Button fx:id="enregistrerBtn" onAction="#enregistrer" style="-fx-background-color: #27ae60;" text="Créer" />
                <Button fx:id="fermerBtn" onAction="#fermerCompte" style="-fx-background-color: #e74c3c;" text="Fermer" textAlignment="CENTER" />
                <Button fx:id="effacerBtn" onAction="#effacer" style="-fx-background-color: #95a5a6;" text="Effacer" />
            </buttons>
        </ButtonBar>

        <!-- Recherche -->
        <TextField fx:id="searchTfd" layoutX="400.0" layoutY="70.0" prefWidth="500.0" promptText="Rechercher par numéro de compte" />
        <Button fx:id="searchBtn" layoutX="910.0" layoutY="70.0" onAction="#searchComptes" style="-fx-background-color: transparent;" text="🔍" />

        <!-- Bouton Retour -->
        <Button fx:id="retourBtn" layoutX="20.0" layoutY="20.0" onAction="#retour" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Retour" />
    </children>
</AnchorPane>
