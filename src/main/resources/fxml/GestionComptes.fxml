<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.banking.digitalbankingproject.controller.GestionComptesController">
    <children>
        <Button fx:id="btnAjouter" layoutX="50.0" layoutY="50.0" mnemonicParsing="false" text="Ajouter" onAction="#handleAjouter"/>
        <Button fx:id="btnSupprimer" layoutX="150.0" layoutY="50.0" mnemonicParsing="false" text="Supprimer" onAction="#handleSupprimer"/>
        <Button fx:id="btnModifier" layoutX="250.0" layoutY="50.0" mnemonicParsing="false" text="Modifier" onAction="#handleModifier"/>
        <Button fx:id="btnRefresh" layoutX="350.0" layoutY="50.0" mnemonicParsing="false" text="Refresh" onAction="#handleRefresh"/>
        <TableView fx:id="tableComptes" layoutX="50.0" layoutY="100.0" prefHeight="400.0" prefWidth="500.0">
            <columns>
                <TableColumn fx:id="columnNumero" text="Numéro"/>
                <TableColumn fx:id="columnSolde" text="Solde"/>
                <TableColumn fx:id="columnProprietaire" text="Propriétaire"/>
            </columns>
        </TableView>
    </children>
</AnchorPane>