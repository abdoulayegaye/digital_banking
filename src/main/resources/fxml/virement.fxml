         <font>
            <Font size="14.0" />
         </font>
      </Text>
      <TextField fx:id="numCompteExpeTfd1" layoutX="225.0" layoutY="114.0" prefHeight="25.0" prefWidth="186.0" promptText="Saisir N° Compte de l'expéditeur " />
      <Text layoutX="226.0" layoutY="262.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Montant">
         <font>
            <Font size="14.0" />
         </font>
      </Text>
      <Button fx:id="retourBtn" cancelButton="true" layoutX="14.0" layoutY="16.0" mnemonicParsing="false" onAction="#retour" prefHeight="32.0" prefWidth="46.0" text="⬅" textAlignment="CENTER">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
