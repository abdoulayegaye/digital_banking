<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="10" style="-fx-padding: 20;" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.VirementController">
    <Label text="Effectuer un virement" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <Label text="Compte source"/>
    <ComboBox fx:id="compteSourceComboBox" promptText="Sélectionner le compte source"/>
    <Label text="Compte destinataire"/>
    <ComboBox fx:id="compteDestComboBox" promptText="Sélectionner le compte destinataire"/>
    <Label text="Montant"/>
    <TextField fx:id="montantField" promptText="Entrez le montant"/>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Effectuer le virement" onAction="#handleEffectuerVirement"/>
        <Button text="Annuler" onAction="#handleAnnuler"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Effectuer le virement" onAction="#handleEffectuerVirement"/>
        <Button text="Imprimer le reçu" onAction="#handleImprimerRecu" fx:id="imprimerButton" disable="true"/>
        <Button text="Annuler" onAction="#handleAnnuler"/>
    </HBox>
</VBox>