<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane fx:id="virementPane" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.VirementController">
    <children>

        <Label layoutX="20.0" layoutY="40.0" text="Virement" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label layoutX="20.0" layoutY="80.0" text="Compte Source:"/>
        <ComboBox fx:id="comboCompteSource" layoutX="150.0" layoutY="80.0" prefWidth="200.0" onAction="#filtrerComptesDestinataire"/>

        <Label layoutX="20.0" layoutY="120.0" text="Compte Destinataire:"/>
        <ComboBox fx:id="comboCompteDestinataire" layoutX="150.0" layoutY="120.0" prefWidth="200.0"/>

        <Label layoutX="20.0" layoutY="160.0" text="Montant:"/>
        <TextField fx:id="txtMontant" layoutX="150.0" layoutY="160.0" prefWidth="200.0"/>

        <Button fx:id="btnVirement" layoutX="150.0" layoutY="200.0" text="Effectuer Virement" onAction="#effectuerVirement"/>
    </children>
</AnchorPane>
