<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="ajouterClientPane" prefWidth="400.0" prefHeight="300.0" minWidth="300.0" minHeight="250.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.AjouterClientController">
    <children>
        <HBox layoutX="10.0" layoutY="10.0">
            <Button fx:id="btnRetour" onAction="#retourGestionClients" style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../../../../../../../Users/CnG/Pictures/fleche%20de%20retour.jpg" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <Label fx:id="lblNom" layoutX="50.0" layoutY="50.0" prefWidth="100.0" prefHeight="30.0" text="Nom" />
        <TextField fx:id="txtNom" layoutX="150.0" layoutY="50.0" prefWidth="200.0" prefHeight="30.0" />
        <Label fx:id="lblPrenom" layoutX="50.0" layoutY="100.0" prefWidth="100.0" prefHeight="30.0" text="Prénom" />
        <TextField fx:id="txtPrenom" layoutX="150.0" layoutY="100.0" prefWidth="200.0" prefHeight="30.0" />
        <Label fx:id="lblEmail" layoutX="50.0" layoutY="150.0" prefWidth="100.0" prefHeight="30.0" text="Email" />
        <TextField fx:id="txtEmail" layoutX="150.0" layoutY="150.0" prefWidth="200.0" prefHeight="30.0" />
        <Button fx:id="btnAjouter" layoutX="150.0" layoutY="200.0" prefWidth="100.0" prefHeight="40.0" text="Ajouter" />
    </children>
</AnchorPane>