<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #1E2A38;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.HistoriqueController">

    <VBox alignment="CENTER" spacing="15" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #00D4FF; -fx-padding: 10px;" text="📜 Historique des Transactions" />

        <TableView fx:id="transactionTable" prefHeight="400" prefWidth="600">
            <columns>
                <TableColumn fx:id="typeColumn" prefWidth="150" style="-fx-alignment: CENTER;" text="📌 Type" />
                <TableColumn fx:id="montantColumn" prefWidth="200" style="-fx-alignment: CENTER;" text="💰 Montant" />
                <TableColumn fx:id="dateColumn" prefWidth="250" style="-fx-alignment: CENTER;" text="📅 Date" />
            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="genererReleveButton" onAction="#genererReleve" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px;" styleClass="menu-button" stylesheets="@css/style.css" text="📄 Générer Relevé" />
            <Button fx:id="fermerButton" onAction="#fermerFenetre" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px;" styleClass="menu-button" stylesheets="@css/style.css" text="❌ Fermer" />
        </HBox>
    </VBox>
</AnchorPane>
