<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane fx:id="historiquePane" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.HistoriqueController">
    <children>
        <HBox layoutX="10.0" layoutY="10.0">
            <Button fx:id="btnRetour" onAction="#retourGestionOperations" style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/retour.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <Label layoutX="20.0" layoutY="40.0" text="Historique des Transactions" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label layoutX="20.0" layoutY="80.0" text="Compte:"/>
        <ComboBox fx:id="comboCompte" layoutX="100.0" layoutY="80.0" prefWidth="200.0"/>

        <Button fx:id="btnAfficher" layoutX="310.0" layoutY="80.0" text="Afficher" onAction="#afficherHistorique"/>
        <Button fx:id="btnGenerer" layoutX="400.0" layoutY="80.0" text="Générer PDF" onAction="#genererPdf"/>

        <TableView fx:id="tableHistorique" layoutX="20.0" layoutY="120.0" prefHeight="400.0" prefWidth="760.0">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="200.0" text="Date"/>
                <TableColumn fx:id="colDescription" prefWidth="150.0" text="Description"/>
                <TableColumn fx:id="colMontant" prefWidth="200.0" text="Montant"/>
                <TableColumn fx:id="colSolde" prefWidth="200.0" text="Solde"/>
            </columns>
        </TableView>
    </children>
</AnchorPane>