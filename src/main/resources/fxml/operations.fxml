<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.OperationController">

    <stylesheets>
    </stylesheets>

    <!-- En-tête -->
    <Text layoutX="350.0" layoutY="50.0" style="-fx-font-size: 24; -fx-fill: #2c3e50;">
        <text>GESTION DES OPÉRATIONS BANCAIRES</text>
    </Text>

    <!-- Formulaire d'opération -->
    <VBox layoutX="50.0" layoutY="100.0" spacing="15">
        <children>
            <!-- Type d'opération -->
            <ComboBox fx:id="typeOperationCombo" prefWidth="300" promptText="Type d'opération" />

            <!-- Compte source (visible uniquement pour les retraits) -->
            <ComboBox fx:id="compteSourceCombo" prefWidth="300" promptText="Compte source" visible="false" />

            <!-- Montant de l'opération -->
            <TextField fx:id="montantField" prefWidth="300" promptText="Montant" />

            <!-- Date de l'opération -->
            <DatePicker fx:id="dateOperationPicker" prefWidth="300" promptText="Date de l'opération" />

            <!-- Bouton Valider -->
            <Button fx:id="validerBtn" onAction="#validerOperation" prefWidth="300" style="-fx-background-color: #27ae60;" text="Valider l'opération" />
        </children>
    </VBox>

    <!-- Historique des transactions -->
    <TableView fx:id="transactionsTable" layoutX="400.0" layoutY="100.0" prefHeight="400.0" prefWidth="500.0">
        <columns>
            <!-- Colonne ID -->
            <TableColumn fx:id="idCol" prefWidth="50" text="ID">
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>

            <!-- Colonne Type -->
            <TableColumn fx:id="typeCol" prefWidth="100" text="Type">
                <cellValueFactory>
                    <PropertyValueFactory property="type" />
                </cellValueFactory>
            </TableColumn>

            <!-- Colonne Montant -->
            <TableColumn fx:id="montantCol" prefWidth="100" text="Montant">
                <cellValueFactory>
                    <PropertyValueFactory property="amount" />
                </cellValueFactory>
            </TableColumn>

            <!-- Colonne Date -->
            <TableColumn fx:id="dateCol" prefWidth="150" text="Date">
                <cellValueFactory>
                    <PropertyValueFactory property="dateOp" />
                </cellValueFactory>
            </TableColumn>

            <!-- Colonne Compte -->
            <TableColumn fx:id="compteCol" prefWidth="100" text="Compte">
                <cellValueFactory>
                    <PropertyValueFactory property="compte" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <!-- Génération PDF -->
    <Button fx:id="pdfBtn" layoutX="50.0" layoutY="400.0" onAction="#genererPDF" style="-fx-background-color: #e74c3c;" text="Générer PDF" />

    <!-- Retour -->
    <Button fx:id="retourBtn" layoutX="39.0" layoutY="27.0" onAction="#retour" style="-fx-background-color: #3498db;" text="Retour" />

</AnchorPane>
