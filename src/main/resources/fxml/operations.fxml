<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<AnchorPane prefHeight="600.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.banking.digitalbankingproject.controller.OperationController">

    <stylesheets>
    </stylesheets>

    <!-- En-tête -->
    <Text layoutX="350.0" layoutY="50.0" style="-fx-font-size: 24; -fx-fill: #2c3e50;">
        <text>GESTION DES OPÉRATIONS BANCAIRES</text>
    </Text>

    <!-- Formulaire d'opération -->
    <VBox layoutX="50.0" layoutY="100.0" spacing="15">
        <children>
            <!-- Type d'opération -->
            <ComboBox fx:id="typeOperationCombo" promptText="Type d'opération" prefWidth="300" />

            <!-- Compte source (visible uniquement pour les retraits) -->
            <ComboBox fx:id="compteSourceCombo" promptText="Compte source" prefWidth="300" visible="false" />

            <!-- Montant de l'opération -->
            <TextField fx:id="montantField" promptText="Montant" prefWidth="300" />

            <!-- Date de l'opération -->
            <DatePicker fx:id="dateOperationPicker" promptText="Date de l'opération" prefWidth="300" />

            <!-- Bouton Valider -->
            <Button fx:id="validerBtn" text="Valider l'opération" style="-fx-background-color: #27ae60;" onAction="#validerOperation" prefWidth="300" />
        </children>
    </VBox>

    <!-- Historique des transactions -->
    <TableView fx:id="transactionsTable" layoutX="400.0" layoutY="100.0" prefHeight="400.0" prefWidth="500.0">
        <columns>
            <!-- Colonne ID -->
            <TableColumn fx:id="idCol" text="ID" prefWidth="50">
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>

            <!-- Colonne Type -->
            <TableColumn fx:id="typeCol" text="Type" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="type" />
                </cellValueFactory>
            </TableColumn>

            <!-- Colonne Montant -->
            <TableColumn fx:id="montantCol" text="Montant" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="amount" />
                </cellValueFactory>
            </TableColumn>

            <!-- Colonne Date -->
            <TableColumn fx:id="dateCol" text="Date" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="dateOp" />
                </cellValueFactory>
            </TableColumn>

            <!-- Colonne Compte -->
            <TableColumn fx:id="compteCol" text="Compte" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="compte" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <!-- Génération PDF -->
    <Button fx:id="pdfBtn" layoutX="50.0" layoutY="400.0" text="Générer PDF" style="-fx-background-color: #e74c3c;" onAction="#genererPDF" />

    <!-- Retour -->
    <Button fx:id="retourBtn" layoutX="900.0" layoutY="20.0" text="Retour" style="-fx-background-color: #3498db;" onAction="#retour" />

</AnchorPane>