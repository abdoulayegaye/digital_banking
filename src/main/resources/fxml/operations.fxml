<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import java.net.URL?>

<BorderPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #f5f6fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.OperationController">
    <!-- Référence au fichier CSS externe -->
    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <!-- Header -->
    <top>
        <VBox spacing="10" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f5f6fa); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Text fill="#2c3e50" style="-fx-font-weight: bold;" text="Gestion des Opérations">
                    <font><Font size="24.0" /></font>
                </Text>
                <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: #ecf0f1; -fx-background-radius: 20; -fx-padding: 5 10 5 10;" HBox.hgrow="ALWAYS">
                    <TextField fx:id="searchField" promptText="Rechercher une opération..." style="-fx-background-radius: 20; -fx-border-color: transparent;" onKeyReleased="#filterOperations" />
                    <Button text="🔍" style="-fx-background-color: transparent; -fx-font-size: 16;" onAction="#filterOperations" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Formulaire principal (amélioré) -->
            <VBox spacing="15" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Compte :" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #34495e; -fx-font-weight: bold; -fx-min-width: 80;" />
                    <ComboBox fx:id="accountCombo" promptText="Sélectionnez un compte" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-font-size: 14; -fx-pref-width: 250;" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Montant :" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #34495e; -fx-font-weight: bold; -fx-min-width: 80;" />
                    <TextField fx:id="amountField" promptText="Entrez le montant" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 8; -fx-font-size: 14; -fx-pref-width: 250;" />
                </HBox>

                <!-- Formulaire de virement (amélioré) -->
                <VBox fx:id="transferForm" spacing="15" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Destinataire :" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #34495e; -fx-font-weight: bold; -fx-min-width: 80;" />
                        <ComboBox fx:id="destAccountCombo" promptText="Compte destinataire" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-font-size: 14; -fx-pref-width: 250;" />
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="15">
                        <Button onAction="#cancelTransfer" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Annuler">
                            <styleClass/>
                        </Button>
                        <Button fx:id="transferBtn" onAction="#handleTransfer" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Confirmer">
                            <styleClass/>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Boutons d'actions (améliorés) -->
                <HBox alignment="CENTER_RIGHT" spacing="15">
                    <Button fx:id="depotBtn"  onAction="#handleDeposit" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Dépôt">
                        <tooltip><Tooltip text="Effectuer un dépôt" /></tooltip>
                        <styleClass/>
                    </Button>
                    <Button fx:id="retraitBtn" onAction="#handleWithdraw" style="-fx-background-color: #f1c40f; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Retrait">
                        <tooltip><Tooltip text="Effectuer un retrait" /></tooltip>
                        <styleClass/>
                    </Button>
                    <Button onAction="#showTransferForm" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Virement">
                        <tooltip><Tooltip text="Effectuer un virement" /></tooltip>
                        <styleClass/>
                    </Button>
                </HBox>
            </VBox>

            <!-- Historique des transactions (TableView inchangé) -->
            <TableView fx:id="operationsTable" prefHeight="400.0" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                <columns>
                    <TableColumn fx:id="idCol" prefWidth="50" text="ID" sortable="true" />
                    <TableColumn fx:id="dateCol" prefWidth="200" text="Date" sortable="true" />
                    <TableColumn fx:id="amountCol" prefWidth="100" text="Montant" sortable="true" />
                    <TableColumn fx:id="typeCol" prefWidth="100" text="Type" sortable="true" />
                    <TableColumn fx:id="accountCol" prefWidth="150" text="Compte" sortable="true" />
                </columns>
                <placeholder>
                    <Label text="Aucune opération trouvée" style="-fx-text-fill: #7f8c8d; -fx-font-size: 16;" />
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <!-- Action Bar (améliorée) -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
            <Button onAction="#Retour" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Retour">
                <tooltip><Tooltip text="Retour à l'accueil" /></tooltip>
                <styleClass/>
            </Button>
        </HBox>
    </bottom>
</BorderPane>