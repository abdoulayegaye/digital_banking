<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="10" style="-fx-padding: 10;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.OperationController">
    <Label text="Gestion des Opérations" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Formulaire pour ajouter/modifier une opération -->
    <HBox spacing="10">
        <TextField fx:id="montantField" promptText="Montant"/>
        <ComboBox fx:id="typeComboBox" promptText="Type d'opération"/>
        <ComboBox fx:id="compteComboBox" promptText="Sélectionner un compte"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Ajouter Opération" onAction="#handleAjouterOperation"/>
        <Button text="Modifier Opération" onAction="#handleModifierOperation"/>
    </HBox>

    <!-- Tableau pour lister les opérations -->
    <TableView fx:id="operationTable">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
            <TableColumn fx:id="montantColumn" text="Montant" prefWidth="100"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="100"/>
            <TableColumn fx:id="compteColumn" text="Compte" prefWidth="150"/>
        </columns>
    </TableView>

    <!-- Boutons pour supprimer, exporter et retourner -->

    <HBox spacing="10">
        <Button text="Supprimer Opération" onAction="#handleSupprimerOperation"/>
        <Button text="Exporter en PDF" onAction="#exportOperationsToPDF"/>
        <Button text="Retour" onAction="#handleRetour"/>
    </HBox>
</VBox>