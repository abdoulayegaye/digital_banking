<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="operationPane" prefWidth="800.0" prefHeight="600.0" minWidth="600.0" minHeight="400.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.OperationsController">
    <top>
        <HBox alignment="CENTER" spacing="20">
            <children>
                <Button fx:id="btnRetour" text="Retour" />
                <Button fx:id="btnActualiser" text="Actualiser" />
                <Label fx:id="lblOperations" prefWidth="700.0" prefHeight="40.0" text="Opérations" />
            </children>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tableOperations" prefWidth="700.0" prefHeight="400.0" />
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="20">
            <children>
                <Button fx:id="btnDepot" prefWidth="150.0" prefHeight="50.0" text="Dépôt" />
                <Button fx:id="btnRetrait" prefWidth="150.0" prefHeight="50.0" text="Retrait" />
                <Button fx:id="btnVirement" prefWidth="150.0" prefHeight="50.0" text="Virement" />
            </children>
        </HBox>
    </bottom>
</BorderPane>