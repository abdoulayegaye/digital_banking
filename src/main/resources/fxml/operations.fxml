<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: #2c3e50;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.banking.digitalbankingproject.controller.OperationController">
    <children>
        <!-- Panneau principal -->
        <AnchorPane layoutX="200.0" prefHeight="500.0" prefWidth="600.0" style="-fx-background-color: #ecf0f1;">
            <children>
                <!-- Titre -->
                <Text layoutX="150.0" layoutY="50.0" text="GESTION DES OPÉRATIONS" strokeType="OUTSIDE" strokeWidth="0.0">
                    <font>
                        <Font name="System Bold Italic" size="28.0" />
                    </font>
                </Text>

                <!-- Champs de saisie -->
                <Text layoutX="30.0" layoutY="100.0" text="COMPTE SOURCE" strokeType="OUTSIDE" strokeWidth="0.0">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>
                <ComboBox fx:id="compteSourceComboBox" layoutX="30.0" layoutY="110.0" prefHeight="30.0" prefWidth="250.0" />

                <Text layoutX="30.0" layoutY="160.0" text="COMPTE DEST." strokeType="OUTSIDE" strokeWidth="0.0">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>
                <ComboBox fx:id="compteDestComboBox" layoutX="30.0" layoutY="170.0" prefHeight="30.0" prefWidth="250.0" />

                <Text layoutX="30.0" layoutY="220.0" text="MONTANT" strokeType="OUTSIDE" strokeWidth="0.0">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>
                <TextField fx:id="montantField" layoutX="30.0" layoutY="230.0" prefHeight="30.0" prefWidth="250.0" />

                <!-- Boutons -->
                <Button fx:id="depotBtn" layoutX="30.0" layoutY="280.0" onAction="#effectuerDepot" prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 8;" text="DÉPÔT" />
                <Button fx:id="retraitBtn" layoutX="140.0" layoutY="280.0" onAction="#effectuerRetrait" prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8;" text="RETRAIT" />
                <Button fx:id="virementBtn" layoutX="250.0" layoutY="280.0" onAction="#effectuerVirement" prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8;" text="VIREMENT" />
                <Button fx:id="historiqueBtn" layoutX="360.0" layoutY="280.0" onAction="#consulterHistorique" prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-background-radius: 8;" text="HISTORIQUE" />

                <!-- TableView pour l'historique -->
                <TableView fx:id="operationTable" layoutX="30.0" layoutY="340.0" prefHeight="150.0" prefWidth="540.0">
                    <columns>
                        <TableColumn fx:id="typeCol" prefWidth="100.0" text="Type" />
                        <TableColumn fx:id="montantCol" prefWidth="100.0" text="Montant" />
                        <TableColumn fx:id="dateCol" prefWidth="140.0" text="Date" />
                        <TableColumn fx:id="compteCol" prefWidth="200.0" text="Compte" />
                    </columns>
                </TableView>
            </children>
        </AnchorPane>

        <!-- Image à gauche -->
        <ImageView fitHeight="500.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/operation-image.jpg" />
            </image>
        </ImageView>
    </children>
</AnchorPane>