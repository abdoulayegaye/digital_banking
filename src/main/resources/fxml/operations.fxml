<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane fx:id="operationPane" prefWidth="800.0" prefHeight="600.0" minWidth="600.0" minHeight="400.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.OperationController">

    <style>-fx-background-color: #F5F7FA;</style>

    <top>

        <HBox alignment="CENTER" spacing="20" prefHeight="80.0" style="-fx-background-color: #1E3A8A; -fx-padding: 15;">
            <children>

                <Button fx:id="btnRetour" text="Retour" prefWidth="100.0" prefHeight="40.0"
                        style="-fx-background-color: #FFFFFF; -fx-text-fill: #1E3A8A; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #00000033, 5, 0, 0, 3);">
                    <padding>
                        <Insets top="5.0" right="15.0" bottom="5.0" left="15.0" />
                    </padding>
                </Button>


                <Button fx:id="btnActualiser" text="Actualiser" prefWidth="100.0" prefHeight="40.0"
                        style="-fx-background-color: #FFFFFF; -fx-text-fill: #1E3A8A; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #00000033, 5, 0, 0, 3);">
                    <padding>
                        <Insets top="5.0" right="15.0" bottom="5.0" left="15.0" />
                    </padding>
                </Button>


                <Label fx:id="lblOperations" text="Opérations" textFill="#FFFFFF" prefWidth="700.0" prefHeight="40.0">
                    <font>
                        <Font name="Arial Bold" size="24.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <center>

        <TableView fx:id="tableOperations" prefWidth="700.0" prefHeight="400.0"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, #0000001A, 10, 0, 0, 5);">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>
        </TableView>
    </center>

    <bottom>

        <HBox alignment="CENTER" spacing="30" prefHeight="100.0" style="-fx-padding: 20;">
            <children>
                <!-- Bouton Dépôt -->
                <Button fx:id="btnDepot" prefWidth="150.0" prefHeight="50.0" text="Dépôt"
                        style="-fx-background-color: #FFFFFF; -fx-text-fill: #1E3A8A; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, #00000033, 10, 0, 0, 5);">
                    <padding>
                        <Insets top="10.0" right="20.0" bottom="10.0" left="20.0" />
                    </padding>
                </Button>

                <!-- Bouton Retrait -->
                <Button fx:id="btnRetrait" prefWidth="150.0" prefHeight="50.0" text="Retrait"
                        style="-fx-background-color: #FFFFFF; -fx-text-fill: #1E3A8A; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, #00000033, 10, 0, 0, 5);">
                    <padding>
                        <Insets top="10.0" right="20.0" bottom="10.0" left="20.0" />
                    </padding>
                </Button>

                <!-- Bouton Virement -->
                <Button fx:id="btnVirement" prefWidth="150.0" prefHeight="50.0" text="Virement"
                        style="-fx-background-color: #FFFFFF; -fx-text-fill: #1E3A8A; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, #00000033, 10, 0, 0, 5);">
                    <padding>
                        <Insets top="10.0" right="20.0" bottom="10.0" left="20.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </bottom>
</BorderPane>