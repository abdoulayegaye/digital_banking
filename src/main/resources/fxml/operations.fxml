<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.banking.digitalbankingproject.controller.OperationController"
            prefHeight="600.0" prefWidth="800.0">
    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" 
              AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            
            <!-- Formulaire des opérations -->
            <GridPane hgap="10" vgap="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                
                <Label text="Compte source:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="comboCompteSource" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                
                <Label text="Compte destination:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="comboCompteDestination" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                
                <Label text="Montant:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtMontant" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                
                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Button fx:id="btnDepot" text="Dépôt" onAction="#effectuerDepot"/>
                    <Button fx:id="btnRetrait" text="Retrait" onAction="#effectuerRetrait"/>
                    <Button fx:id="btnVirement" text="Virement" onAction="#effectuerVirement"/>
                    <Button fx:id="btnRetour" text="Retour" onAction="#retourAccueil"/>
                </HBox>
            </GridPane>
            
            <!-- Historique des opérations -->
            <TableView fx:id="tableOperations" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="colMontant" text="Montant" prefWidth="100"/>
                    <TableColumn fx:id="colCompte" text="Compte" prefWidth="200"/>
                </columns>
            </TableView>
            
        </VBox>
    </children>
</AnchorPane>
