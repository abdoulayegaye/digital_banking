<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="262.0" prefWidth="382.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.GestionOperationsController">
    <children>
        <VBox layoutX="30.0" layoutY="7.0" prefHeight="224.0" prefWidth="333.0" spacing="10.0">
            <HBox spacing="10.0">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Gestion des Opérations" />
            </HBox>
            <VBox spacing="10.0">
                <HBox spacing="10.0">
                    <Button fx:id="btnDepot" mnemonicParsing="false" onAction="#allerDepot" text="Dépôt" />
                    <Button fx:id="btnRetrait" mnemonicParsing="false" onAction="#allerRetrait" text="Retrait" />
                    <Button fx:id="btnVirement" mnemonicParsing="false" onAction="#allerVirement" text="Virement" />
                </HBox>
                <HBox spacing="10.0">
                    <Button fx:id="btnHistorique" mnemonicParsing="false" onAction="#allerHistorique" text="Historique" />
                </HBox>
                <HBox spacing="10.0" />
            </VBox>
            <Button fx:id="btnRetour" alignment="BOTTOM_LEFT" mnemonicParsing="false" onAction="#retourAccueil">
                <graphic>
                    <ImageView fx:id="imgRetour" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/retour.png" />
                        </image>
                    </ImageView>
                </graphic>
                <text>Retour</text>
            </Button>
        </VBox>
    </children>
</AnchorPane>