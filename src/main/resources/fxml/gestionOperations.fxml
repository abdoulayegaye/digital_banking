<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.GestionOperationController">
   <top>
      <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="Gestion des Opérations" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnRetour" mnemonicParsing="false" onAction="#handleRetour" text="Retour" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <Tab text="Dépôt / Retrait">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0">
                     <children>
                        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <TitledPane animated="false" text="Sélection du compte">
                                 <content>
                                    <GridPane hgap="10.0" vgap="10.0">
                                       <columnConstraints>
                                          <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" />
                                          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                       </rowConstraints>
                                       <children>
                                          <Label text="Client:" />
                                          <Label text="Compte:" GridPane.rowIndex="1" />
                                          <ComboBox fx:id="comboClientsDepotRetrait" prefWidth="200.0" promptText="Sélectionner un client" GridPane.columnIndex="1" />
                                          <ComboBox fx:id="comboComptesDepotRetrait" prefWidth="200.0" promptText="Sélectionner un compte" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                       </children>
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                    </GridPane>
                                 </content>
                              </TitledPane>
                              <TitledPane animated="false" text="Détails de l'opération">
                                 <content>
                                    <GridPane hgap="10.0" vgap="10.0">
                                       <columnConstraints>
                                          <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" />
                                          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                       </rowConstraints>
                                       <children>
                                          <Label text="Type d'opération:" />
                                          <Label text="Montant:" GridPane.rowIndex="1" />
                                          <Label text="Solde actuel:" GridPane.rowIndex="2" />
                                          <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1">
                                             <children>
                                                <RadioButton fx:id="radioDepot" mnemonicParsing="false" selected="true" text="Dépôt">
                                                   <toggleGroup>
                                                      <ToggleGroup fx:id="typeOperation" />
                                                   </toggleGroup>
                                                </RadioButton>
                                                <RadioButton fx:id="radioRetrait" mnemonicParsing="false" text="Retrait" toggleGroup="$typeOperation" />
                                             </children>
                                          </HBox>
                                          <TextField fx:id="txtMontantDepotRetrait" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                          <Label fx:id="lblSoldeActuelDepotRetrait" text="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                       </children>
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                    </GridPane>
                                 </content>
                              </TitledPane>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Button fx:id="btnEffectuerDepotRetrait" mnemonicParsing="false" onAction="#handleEffectuerDepotRetrait" text="Effectuer l'opération" />
                                    <Button fx:id="btnAnnulerDepotRetrait" mnemonicParsing="false" onAction="#handleAnnulerDepotRetrait" text="Annuler" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="Virement">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0">
                     <children>
                        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <TitledPane animated="false" text="Compte source">
                                 <content>
                                    <GridPane hgap="10.0" vgap="10.0">
                                       <columnConstraints>
                                          <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" />
                                          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                       </rowConstraints>
                                       <children>
                                          <Label text="Client source:" />
                                          <Label text="Compte source:" GridPane.rowIndex="1" />
                                          <Label text="Solde disponible:" GridPane.rowIndex="2" />
                                          <ComboBox fx:id="comboClientSource" prefWidth="200.0" promptText="Sélectionner un client" GridPane.columnIndex="1" />
                                          <ComboBox fx:id="comboCompteSource" prefWidth="200.0" promptText="Sélectionner un compte" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                          <Label fx:id="lblSoldeSource" text="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                       </children>
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                    </GridPane>
                                 </content>
                              </TitledPane>
                              <TitledPane animated="false" text="Compte destination">
                                 <content>
                                    <GridPane hgap="10.0" vgap="10.0">
                                       <columnConstraints>
                                          <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" />
                                          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                       </rowConstraints>
                                       <children>
                                          <Label text="Client destination:" />
                                          <Label text="Compte destination:" GridPane.rowIndex="1" />
                                          <ComboBox fx:id="comboClientDestination" prefWidth="200.0" promptText="Sélectionner un client" GridPane.columnIndex="1" />
                                          <ComboBox fx:id="comboCompteDestination" prefWidth="200.0" promptText="Sélectionner un compte" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                       </children>
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                    </GridPane>
                                 </content>
                              </TitledPane>
                              <TitledPane animated="false" text="Détails du virement">
                                 <content>
                                    <GridPane hgap="10.0" vgap="10.0">
                                       <columnConstraints>
                                          <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" />
                                          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                       </rowConstraints>
                                       <children>
                                          <Label text="Montant:" />
                                          <TextField fx:id="txtMontantVirement" GridPane.columnIndex="1" />
                                       </children>
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                    </GridPane>
                                 </content>
                              </TitledPane>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Button fx:id="btnEffectuerVirement" mnemonicParsing="false" onAction="#handleEffectuerVirement" text="Effectuer le virement" />
                                    <Button fx:id="btnAnnulerVirement" mnemonicParsing="false" onAction="#handleAnnulerVirement" text="Annuler" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="Historique des opérations">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0">
                     <children>
                        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label text="Client:" />
                                    <ComboBox fx:id="comboClientsHistorique" prefWidth="200.0" promptText="Sélectionner un client" />
                                    <Label text="Compte:" />
                                    <ComboBox fx:id="comboComptesHistorique" prefWidth="200.0" promptText="Sélectionner un compte" />
                                    <Button fx:id="btnAfficherHistorique" mnemonicParsing="false" onAction="#handleAfficherHistorique" text="Afficher l'historique" />
                                    <Button fx:id="btnGenererPDF" mnemonicParsing="false" onAction="#handleGenererPDF" text="Générer PDF" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tableOperations" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colIdOperation" prefWidth="75.0" text="ID" />
                                    <TableColumn fx:id="colCompteId" prefWidth="100.0" text="Compte ID" />
                                    <TableColumn fx:id="colMontant" prefWidth="150.0" text="Montant" />
                                    <TableColumn fx:id="colTypeOperation" prefWidth="150.0" text="Type d'opération" />
                                    <TableColumn fx:id="colDate" prefWidth="150.0" text="Date" />
                                 </columns>
                              </TableView>
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </center>
</BorderPane> 