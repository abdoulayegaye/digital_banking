<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="associerClientPane" prefHeight="200.0" prefWidth="400.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.AssocierClientController">
    <children>

        <Label layoutX="20.0" layoutY="40.0" text="Associer un Client" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label layoutX="20.0" layoutY="80.0" text="Client:"/>
        <ComboBox fx:id="comboClient" layoutX="100.0" layoutY="80.0" prefWidth="200.0"/>

        <Button fx:id="btnAssocier" layoutX="100.0" layoutY="120.0" text="Associer" onAction="#associerClient"/>
    </children>
</AnchorPane>