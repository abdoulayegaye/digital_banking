      </ImageView>
      <Text layoutX="154.0" layoutY="35.0" strokeType="OUTSIDE" strokeWidth="0.0" text="BIENVENUE A DIGITAL BANK">
         <font>
            <Font name="Times New Roman" size="24.0" />
         </font>
      </Text>
      <Button layoutX="248.0" layoutY="79.0" mnemonicParsing="false" onAction="#Gestion_Comptes" prefHeight="34.0" prefWidth="150.0" style="-fx-background-color: blue;" text="Gestion des Comptes" textFill="WHITE">
         <font>
            <Font name="Roboto" size="14.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
