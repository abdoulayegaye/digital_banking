<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.paint.Color?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.banking.digitalbankingproject.controller.AccueilController"
            prefHeight="500.0" prefWidth="800.0"
            style="-fx-background-color: #f5f5f5;">

    <!-- En-tête -->
    <VBox alignment="CENTER" spacing="10" layoutX="0" layoutY="20" prefWidth="800.0">
        <Text text="Digital Banking" style="-fx-font-size: 28px; -fx-fill: #2E3A87; -fx-font-weight: bold;" />
        <Text text="Gestion des clients, comptes et opérations" style="-fx-font-size: 14px; -fx-fill: #666;" />
    </VBox>

    <!-- Conteneur pour les boutons -->
    <HBox alignment="CENTER" spacing="30" layoutX="0" layoutY="200" prefWidth="800.0">
        <!-- Bouton Client -->
        <Button fx:id="clientBtn" text="Client" onAction="#showClient"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 15 30; -fx-font-size: 16px; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0.0, 0, 2);">
            >
        </Button>

        <!-- Bouton Opération -->
        <Button fx:id="operationBtn" text="Opération" onAction="#showOperation"
                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-padding: 15 30; -fx-font-size: 16px; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0.0, 0, 2);">

        </Button>

        <!-- Bouton Compte -->
        <Button fx:id="compteBtn" text="Compte" onAction="#showCompte"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 15 30; -fx-font-size: 16px; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0.0, 0, 2);">

        </Button>
    </HBox>

    <!-- Pied de page -->
    <VBox alignment="CENTER" spacing="10" layoutX="0" layoutY="450" prefWidth="800.0">
        <Text text="© 2023 Digital Banking. Tous droits réservés." style="-fx-font-size: 12px; -fx-fill: #666;" />
    </VBox>

</AnchorPane>