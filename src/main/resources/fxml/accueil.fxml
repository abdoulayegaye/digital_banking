<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefWidth="800.0" prefHeight="600.0" minWidth="600.0" minHeight="400.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.AccueilController">
    <children>
        <!-- Titre "Bienvenue" -->
        <Label fx:id="lblBienvenue" layoutX="50.0" layoutY="30.0" prefWidth="700.0" prefHeight="40.0" text="Bienvenue" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <!-- Bouton "Clients" -->
        <Button fx:id="btnClients" layoutX="100.0" layoutY="150.0" prefWidth="200.0" prefHeight="50.0" text="Clients" onAction="#allerGestionClients" />

        <!-- Bouton "Comptes" -->
        <Button fx:id="btnComptes" layoutX="300.0" layoutY="150.0" prefWidth="200.0" prefHeight="50.0" text="Comptes" onAction="#allerGestionComptes" />

        <!-- Bouton "Opérations" -->
        <Button fx:id="btnOperations" layoutX="500.0" layoutY="150.0" prefWidth="200.0" prefHeight="50.0" text="Opérations" onAction="#allerGestionOperations" />

        <!-- Bouton "Déconnexion" -->
        <Button fx:id="btnLogout" layoutX="350.0" layoutY="500.0" prefWidth="100.0" prefHeight="40.0" text="Déconnexion" onAction="#deconnexion" />
    </children>
</AnchorPane>