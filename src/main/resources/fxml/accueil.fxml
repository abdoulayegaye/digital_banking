<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="rootPane" minHeight="400.0" minWidth="600.0" prefHeight="600.0" prefWidth="800.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.banking.digitalbankingproject.controller.AccueilController">
    <children>
        <!-- Titre "Bienvenue" -->
        <Label fx:id="lblBienvenue" layoutX="50.0" layoutY="30.0" prefHeight="40.0" prefWidth="700.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Bienvenue" />

        <!-- Bouton "Clients" -->
        <Button fx:id="btnClients" layoutX="300.0" layoutY="150.0" onAction="#allerGestionClients" prefHeight="50.0" prefWidth="200.0" text="Clients" />

        <!-- Bouton "Comptes" -->
        <Button fx:id="btnComptes" layoutX="300.0" layoutY="250.0" onAction="#allerGestionComptes" prefHeight="50.0" prefWidth="200.0" text="Comptes" />

        <!-- Bouton "Opérations" -->
        <Button fx:id="btnOperations" layoutX="300.0" layoutY="345.0" onAction="#allerGestionOperations" prefHeight="50.0" prefWidth="200.0" text="Opérations" />

        <!-- Bouton "Déconnexion" -->
        <Button fx:id="btnLogout" layoutX="350.0" layoutY="500.0" onAction="#deconnexion" prefHeight="40.0" prefWidth="100.0" text="Déconnexion" />
    </children>
</AnchorPane>
