      </ImageView>
      <ImageView fitHeight="56.0" fitWidth="69.0" layoutX="193.0" layoutY="9.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/banque.png" />
         </image>
      </ImageView>
      <VBox alignment="CENTER" layoutX="8.0" layoutY="65.0" prefHeight="311.0" prefWidth="100.0" spacing="100.0">
