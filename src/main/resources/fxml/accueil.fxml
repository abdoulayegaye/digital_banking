<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.javafx.controllers.AccueilControler">
    <top>
        <MenuBar prefHeight="53.0" prefWidth="800.0" stylesheets="@../css/login.css" BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="Fichier">
                    <items>
                        <Menu mnemonicParsing="false" text="Créer">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#afficherClient" text="Client" />
                                <MenuItem mnemonicParsing="false"  onAction="#compte" text="Compte" />
                                <MenuItem mnemonicParsing="false" onAction="#Operation" text="Operation" />
                            </items>
                        </Menu>
                        <MenuItem mnemonicParsing="false" text="Fermer" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Editer">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Supprimer" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Aide">
                    <items>
                        <MenuItem mnemonicParsing="false" text="À propos" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <Label styleClass="title-label" text="Bienvenue à la Banque">
                <font>
                    <Font name="Arial Bold" size="24.0" />
                </font>
            </Label>
            <HBox alignment="CENTER" spacing="30.0">
                <Button onAction="#afficherClient" styleClass="primary-button" text="Créer un Client" />
                <Button onAction="#compte" styleClass="primary-button" text="Créer un Compte" />
                <Button onAction="#Operation" styleClass="primary-button" text="Nouvelle Opération" />
            </HBox>
            <VBox alignment="CENTER" spacing="10.0">
                <Label styleClass="subtitle-label" text="Informations récentes">
                    <font>
                        <Font name="Arial Bold" size="18.0" />
                    </font>
                </Label>
                <Label styleClass="info-label" text="Aucune activité récente pour le moment." />
            </VBox>
        </VBox>
    </center>
    <bottom>
        <Label styleClass="footer-label" text="© 2025 Banque - Tous droits réservés" BorderPane.alignment="CENTER" />
    </bottom>
</BorderPane>
