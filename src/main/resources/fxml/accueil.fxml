      </Button>
      <Button layoutX="459.0" layoutY="79.0" mnemonicParsing="false" onAction="#Gestion_Operations" prefHeight="34.0" prefWidth="173.0" style="-fx-background-color: blue;" text="Gestion des Opérations" textFill="WHITE">
