      </Button>
      <Button layoutX="23.0" layoutY="79.0" mnemonicParsing="false" onAction="#Gestion_clients" prefHeight="34.0" prefWidth="150.0" style="-fx-background-color: blue;" text="Gestion des Clients" textFill="WHITE">
