<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane fx:id="rootPane" prefWidth="800.0" prefHeight="600.0" minWidth="600.0" minHeight="400.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.AccueilController">
   <!-- Fond avec une image bancaire -->
   <children>
      <ImageView fitWidth="800.0" fitHeight="600.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <!-- Image de fond bancaire corrigée -->
            <Image url="@../images/bank-background.jpg" />
         </image>
      </ImageView>

      <!-- Couche semi-transparente pour lisibilité -->
      <Rectangle fx:id="overlay" width="800.0" height="600.0" fill="#00000033" opacity="0.5" />

      <!-- Conteneur principal avec style -->
      <VBox layoutX="0.0" layoutY="0.0" prefWidth="800.0" prefHeight="600.0" alignment="CENTER" spacing="20.0">
         <!-- En-tête avec logo et titre -->
         <children>
            <HBox alignment="CENTER" prefWidth="800.0" prefHeight="100.0" style="-fx-background-color: #1E3A8A; -fx-padding: 10;">
               <children>
                  <!-- Logo de la banque -->
                  <ImageView fx:id="logo" fitWidth="60.0" fitHeight="60.0">
                     <image>
                        <Image url="@../images/logo.png" />
                     </image>
                  </ImageView>
                  <!-- Titre "Bienvenue" -->
                  <Label fx:id="lblBienvenue" text="Bienvenue à Digital Banking" textFill="#FFFFFF">
                     <font>
                        <Font name="Arial Bold" size="28.0" />
                     </font>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </Label>
               </children>
            </HBox>

            <!-- Conteneur des boutons principaux -->
            <HBox alignment="CENTER" spacing="30.0" prefWidth="800.0">
               <children>
                  <!-- Bouton "Clients" -->
                  <Button fx:id="btnClients" prefWidth="180.0" prefHeight="60.0" text="Clients" onAction="#allerGestionClients"
                          style="-fx-background-color: #FFFFFF; -fx-text-fill: #1E3A8A; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, #00000033, 10, 0, 0, 5);">
                     <padding>
                        <Insets top="10.0" right="20.0" bottom="10.0" left="20.0" />
                     </padding>
                  </Button>

                  <!-- Bouton "Comptes" -->
                  <Button fx:id="btnComptes" prefWidth="180.0" prefHeight="60.0" text="Comptes" onAction="#allerGestionComptes"
                          style="-fx-background-color: #FFFFFF; -fx-text-fill: #1E3A8A; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, #00000033, 10, 0, 0, 5);">
                     <padding>
                        <Insets top="10.0" right="20.0" bottom="10.0" left="20.0" />
                     </padding>
                  </Button>

                  <!-- Bouton "Opérations" -->
                  <Button fx:id="btnOperations" prefWidth="180.0" prefHeight="60.0" text="Opérations" onAction="#allerGestionOperations"
                          style="-fx-background-color: #FFFFFF; -fx-text-fill: #1E3A8A; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, #00000033, 10, 0, 0, 5);">
                     <padding>
                        <Insets top="10.0" right="20.0" bottom="10.0" left="20.0" />
                     </padding>
                  </Button>
               </children>
            </HBox>

            <!-- Bouton "Déconnexion" en bas -->
            <Button fx:id="btnLogout" prefWidth="150.0" prefHeight="40.0" text="Déconnexion" onAction="#deconnexion"
                    style="-fx-background-color: #FFD700; -fx-text-fill: #1E3A8A; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #00000033, 5, 0, 0, 3);">
               <padding>
                  <Insets top="5.0" right="15.0" bottom="5.0" left="15.0" />
               </padding>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>