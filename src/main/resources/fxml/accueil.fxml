<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #2c3e50;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.banking.digitalbankingproject.controller.AccueilController">
    <children>
        <!-- Panneau principal à droite -->
        <AnchorPane layoutX="200.0" prefHeight="400.0" prefWidth="400.0" style="-fx-background-color: #ecf0f1;">
            <children>
                <!-- Titre -->
                <Text layoutX="50.0" layoutY="60.0" text="BANQUE NUMÉRIQUE" strokeType="OUTSIDE" strokeWidth="0.0">
                    <font>
                        <Font name="System Bold Italic" size="28.0" />
                    </font>
                </Text>

                <!-- Bouton Gestion des Clients -->
                <Button layoutX="50.0" layoutY="120.0" mnemonicParsing="false"
                        onAction="#redirectToGestionClients" prefHeight="40.0" prefWidth="300.0"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8;"
                        text="GESTION DES CLIENTS">
                    <font>
                        <Font name="Arial" size="16.0" />
                    </font>
                </Button>

                <!-- Bouton Gestion des Comptes -->
                <Button layoutX="50.0" layoutY="180.0" mnemonicParsing="false"
                        onAction="#redirectToGestionComptes" prefHeight="40.0" prefWidth="300.0"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 8;"
                        text="GESTION DES COMPTES">
                    <font>
                        <Font name="Arial" size="16.0" />
                    </font>
                </Button>

                <!-- Bouton Gestion des Opérations -->
                <Button layoutX="50.0" layoutY="240.0" mnemonicParsing="false"
                        onAction="#redirectToGestionOperations" prefHeight="40.0" prefWidth="300.0"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-background-radius: 8;"
                        text="GESTION DES OPÉRATIONS">
                    <font>
                        <Font name="Arial" size="16.0" />
                    </font>
                </Button>

                <!-- Texte de pied de page -->
                <Text layoutX="50.0" layoutY="380.0" text="© 2025 Digital Banking Project"
                      strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: #7f8c8d;">
                    <font>
                        <Font name="Arial" size="12.0" />
                    </font>
                </Text>
            </children>
        </AnchorPane>

        <!-- Image à gauche -->
        <ImageView fitHeight="400.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/banque-image.jpg" />
            </image>
        </ImageView>
    </children>
</AnchorPane>