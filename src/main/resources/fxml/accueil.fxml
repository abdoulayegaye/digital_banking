<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import java.lang.String?>
<?import java.net.URL?>
<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #3498db);"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.AccueilController">
    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>
    <!-- Barre de navigation -->
    <HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="800.0" style="-fx-background-color: #ffffff15; -fx-background-radius: 0 0 20 20;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets left="20.0" right="20.0" top="10.0" bottom="10.0" />
        </padding>
        <Text strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: white;" text="Digital Banking Home Page">
            <font>
                <Font name="Arial Rounded MT Bold" size="28.0" />
            </font>
            <effect>
                <DropShadow color="#00000050" radius="5" spread="0.2" />
            </effect>
        </Text>
        <HBox HBox.hgrow="ALWAYS" />
        <Button fx:id="logoutBtn" mnemonicParsing="false" onAction="#handleLogout" text="Déconnexion"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-family: 'Arial'; -fx-font-weight: bold;">
            <font>
                <Font size="14.0" />
            </font>
            <effect>
                <DropShadow color="#00000050" radius="5" />
            </effect>
            <tooltip>
                <Tooltip text="Se déconnecter de la session" />
            </tooltip>
        </Button>
    </HBox>

    <!-- Conteneur principal des boutons -->
    <VBox alignment="CENTER" prefHeight="480.0" prefWidth="800.0" spacing="30" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="120.0">
        <padding>
            <Insets top="20" bottom="20" left="20" right="20" />
        </padding>

        <!-- Bouton Clients -->
        <Button fx:id="ClientBtn" mnemonicParsing="false" onAction="#GestionClient" prefHeight="80.0" prefWidth="400.0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-family: 'Arial'; -fx-font-weight: bold; -fx-cursor: hand;">
            <font>
                <Font size="20.0" />
            </font>
            <graphic>
                <ImageView fitHeight="30.0" fitWidth="30.0">
                    <image>
                        <Image url="@../images/costumer.png" />
                    </image>
                </ImageView>
            </graphic>
            <text>
                Gérer les Clients
            </text>
            <effect>
                <DropShadow color="#00000040" radius="10" />
            </effect>
            <tooltip>
                <Tooltip text="Accéder à la gestion des clients" />
            </tooltip>
        </Button>

        <!-- Bouton Comptes -->
        <Button fx:id="CompteBtn" mnemonicParsing="false" onAction="#GestionCompte" prefHeight="80.0" prefWidth="400.0"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-family: 'Arial'; -fx-font-weight: bold; -fx-cursor: hand;">
            <font>
                <Font size="20.0" />
            </font>
            <graphic>
                <ImageView fitHeight="30.0" fitWidth="30.0">
                    <image>
                        <Image url="@../images/accounting.png" />
                    </image>
                </ImageView>
            </graphic>
            <text>
                Gérer les Comptes
            </text>
            <effect>
                <DropShadow color="#00000040" radius="10" />
            </effect>
            <tooltip>
                <Tooltip text="Accéder à la gestion des comptes" />
            </tooltip>
        </Button>

        <!-- Bouton Opérations -->
        <Button fx:id="OperationBtn" mnemonicParsing="false" onAction="#GestionOperation" prefHeight="80.0" prefWidth="400.0"
                style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-family: 'Arial'; -fx-font-weight: bold; -fx-cursor: hand;">
            <font>
                <Font size="20.0" />
            </font>
            <graphic>
                <ImageView fitHeight="30.0" fitWidth="30.0">
                    <image>
                        <Image url="@../images/operation.png" />
                    </image>
                </ImageView>
            </graphic>
            <text>
                Gérer les Opérations
            </text>
            <effect>
                <DropShadow color="#00000040" radius="10" />
            </effect>
            <tooltip>
                <Tooltip text="Accéder à la gestion des opérations" />
            </tooltip>
        </Button>
    </VBox>

    <!-- Barre de statut -->
    <HBox alignment="CENTER_RIGHT" prefHeight="40.0" prefWidth="800.0" style="-fx-background-color: #00000020;"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets right="20.0" />
        </padding>
        <Label fx:id="userStatus" style="-fx-text-fill: white; -fx-font-family: 'Arial'; -fx-font-size: 14;" text="Connecté en tant que : Administrateur" />
    </HBox>

</AnchorPane>