<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.AcceuilController">
   <top>
      <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="Système de Gestion Bancaire" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label text="Bienvenue dans votre application de gestion bancaire" textAlignment="CENTER">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   <center>
      <GridPane alignment="CENTER" hgap="20.0" vgap="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="150.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="150.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="150.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <VBox alignment="CENTER" spacing="10.0" styleClass="module-box">
               <children>
                  <Label text="Gestion des Clients" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label text="Créer, modifier et gérer les informations des clients" textAlignment="CENTER" wrapText="true" />
                  <Button fx:id="btnGestionClients" maxWidth="200.0" mnemonicParsing="false" onAction="#handleGestionClients" text="Accéder" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <VBox alignment="CENTER" spacing="10.0" styleClass="module-box" GridPane.columnIndex="1">
               <children>
                  <Label text="Gestion des Comptes" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label text="Créer, consulter et gérer les comptes bancaires" textAlignment="CENTER" wrapText="true" />
                  <Button fx:id="btnGestionComptes" maxWidth="200.0" mnemonicParsing="false" onAction="#handleGestionComptes" text="Accéder" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <VBox alignment="CENTER" spacing="10.0" styleClass="module-box" GridPane.rowIndex="1">
               <children>
                  <Label text="Opérations Bancaires" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label text="Effectuer des dépôts, retraits et virements" textAlignment="CENTER" wrapText="true" />
                  <Button fx:id="btnGestionOperations" maxWidth="200.0" mnemonicParsing="false" onAction="#handleGestionOperations" text="Accéder" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <VBox alignment="CENTER" spacing="10.0" styleClass="module-box" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Label text="Historique et Relevés" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label text="Consulter l'historique des transactions et générer des relevés" textAlignment="CENTER" wrapText="true" />
                  <Button fx:id="btnHistoriqueReleves" maxWidth="200.0" mnemonicParsing="false" onAction="#handleHistoriqueReleves" text="Accéder" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <VBox alignment="CENTER" spacing="10.0" styleClass="module-box" GridPane.rowIndex="2">
               <children>
                  <Label text="Paramètres" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label text="Configurer les paramètres de l'application" textAlignment="CENTER" wrapText="true" />
                  <Button fx:id="btnParametres" maxWidth="200.0" mnemonicParsing="false" onAction="#handleParametres" text="Accéder" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <VBox alignment="CENTER" spacing="10.0" styleClass="module-box" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <Label text="Déconnexion" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label text="Se déconnecter de l'application" textAlignment="CENTER" wrapText="true" />
                  <Button fx:id="btnDeconnexion" maxWidth="200.0" mnemonicParsing="false" onAction="#handleDeconnexion" text="Déconnexion" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </children>
      </GridPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="© 2024 - Système de Gestion Bancaire" />
         </children>
      </HBox>
   </bottom>
</BorderPane>