<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.banking.digitalbankingproject.controller.AccueilController"
            prefHeight="900.0" prefWidth="1400.0"
            styleClass="root"
            stylesheets="@../css/style.css">
            
    <top>
        <VBox>
            <HBox styleClass="header" alignment="CENTER" style="-fx-padding: 20;">
                <Label text="Digital Banking" fx:id="welcomeLabel" style="-fx-font-size: 32; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <Button text="Déconnexion" onAction="#logout" styleClass="button-danger" style="-fx-font-size: 14;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox styleClass="menu-container" alignment="CENTER" spacing="40">
            <padding>
                <Insets top="50" bottom="50"/>
            </padding>
            <VBox alignment="CENTER" spacing="40">
                <Button text="Gestion des Clients" onAction="#goToClients" 
                        styleClass="menu-button" style="-fx-font-size: 18; -fx-pref-width: 300; -fx-pref-height: 60;"/>
                        
                <Button text="Gestion des Comptes" onAction="#goToComptes"
                        styleClass="menu-button" style="-fx-font-size: 18; -fx-pref-width: 300; -fx-pref-height: 60;"/>
                        
                <Button text="Opérations Bancaires" onAction="#goToOperations"
                        styleClass="menu-button" style="-fx-font-size: 18; -fx-pref-width: 300; -fx-pref-height: 60;"/>
            </VBox>
        </VBox>
    </center>
    
    <bottom>
        <HBox styleClass="footer" alignment="CENTER" style="-fx-padding: 20;"/>
    </bottom>
    
</BorderPane>
