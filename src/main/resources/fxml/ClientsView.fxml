<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="523.0" prefWidth="515.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.ClientsController">
    <VBox spacing="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestion des Clients" />

        <HBox spacing="10">
            <TextField fx:id="txtClientName" promptText="Nom du client" />
            <Button onAction="#addClient" text="Ajouter Client" />
        </HBox>

        <ListView fx:id="clientListView" />

        <Button onAction="#deleteClient" text="Supprimer Client" />
    </VBox>
</AnchorPane>
