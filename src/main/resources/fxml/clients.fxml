   <children>
      <ImageView fitHeight="491.0" fitWidth="322.0" layoutX="-22.0" layoutY="-9.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/téléchargement%20(1).jpeg" />
         </image>
      </ImageView>
      <Button fx:id="btnajout" layoutX="361.0" layoutY="126.0" mnemonicParsing="false" onAction="#ajout_client" prefHeight="25.0" prefWidth="201.0" text="AJOUTER CLIENT" />
      <Button fx:id="btnlisteClient" layoutX="361.0" layoutY="194.0" mnemonicParsing="false" onAction="#list_client" prefHeight="25.0" prefWidth="201.0" text="LISTE DES CLIENTS" />
      <Button fx:id="btnRetour" layoutX="300.0" layoutY="1.0" mnemonicParsing="false" onAction="#retour_gestion" text="RETOUR" />
   </children>
   
</AnchorPane>
