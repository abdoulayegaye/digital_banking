<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.ClientController">
   <children>
      <AnchorPane layoutX="200.0" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: Blue;">
         <children>
            <Text fill="WHITE" layoutX="28.0" layoutY="30.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ESPACE CLIENTS">
               <font>
                  <Font name="System Bold" size="19.0" />
               </font>
            </Text>
         </children>
      </AnchorPane>
      <AnchorPane layoutX="4.0" layoutY="70.0" prefHeight="200.0" prefWidth="200.0" style="-fx-border-color: blue;">
         <children>
            <TextField fx:id="nomField" layoutX="26.0" layoutY="14.0" promptText="Nom" style="-fx-background-color: transparent; -fx-border-color: blue; -fx-border-width: 0px 0px 2px 0px;" />
            <TextField fx:id="prenomField" layoutX="26.0" layoutY="51.0" promptText="Prenom" style="-fx-background-color: transparent; -fx-border-color: blue; -fx-border-width: 0px 0px 2px 0px;" />
            <TextField fx:id="emailField" layoutX="26.0" layoutY="87.0" promptText="Email" style="-fx-background-color: transparent; -fx-border-color: blue; -fx-border-width: 0px 0px 2px 0px;" />
            <TextField fx:id="idField" layoutX="27.0" layoutY="125.0" promptText="ID" style="-fx-background-color: transparent; -fx-border-color: blue; -fx-border-width: 0px 0px 2px 0px;" />
            <Button fx:id="fxajouter" layoutX="57.0" layoutY="165.0" onAction="#ajouterClient" prefHeight="27.0" prefWidth="77.0" style="-fx-background-color: blue;" text="Ajouter" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
                
            </Button>
         </children>
      </AnchorPane>
      <TableView fx:id="clientTableView" layoutX="222.0" layoutY="70.0" onMouseClicked="#selectionnerClient" prefHeight="200.0" prefWidth="374.0">
        <columns>
          <TableColumn fx:id="idClientColumn" prefWidth="42.0" text="ID" />
          <TableColumn fx:id="prenomClientColumn" prefWidth="100.66668701171875" text="PRENOM" />
            <TableColumn fx:id="nomClientColumn" prefWidth="84.0" text="NOM" />
            <TableColumn fx:id="emailClientColumn" prefWidth="145.33331298828125" text="EMAIL" />
        </columns>
      </TableView>
      <Button layoutX="222.0" layoutY="279.0" mnemonicParsing="false" onAction="#modifierClient" prefHeight="25.0" prefWidth="99.0" style="-fx-background-color: blue;" text="Modifier" textFill="WHITE">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
      <Button layoutX="343.0" layoutY="279.0" mnemonicParsing="false" onAction="#supprimerClient" prefHeight="25.0" prefWidth="99.0" style="-fx-background-color: red;" text="Supprimer" textFill="WHITE">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
      <Button fx:id="retourButton" layoutX="4.0" layoutY="10.0" mnemonicParsing="false" onAction="#retourPagePrecedente" style="-fx-background-color: blue;" text="&lt;--Retour">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
