<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.banking.digitalbankingproject.controller.ClientController"
            prefHeight="700.0" prefWidth="1400.0"
            stylesheets="@../css/style.css">
            
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label text="Gestion des Clients" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Retour" onAction="#goToAccueil" styleClass="button-secondary"/>
        </HBox>
    </top>
    
    <left>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">
            <Label text="Informations Client" styleClass="section-label">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
                <style>
                    -fx-text-fill: #2c3e50;
                </style>
            </Label>
            
            <GridPane vgap="15" hgap="10">
                <padding>
                    <Insets top="10"/>
                </padding>
                
                <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0" 
                       style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="nomTfd" GridPane.rowIndex="0" GridPane.columnIndex="1" 
                          style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dee2e6; -fx-background-color: white; -fx-padding: 8;"/>
                
                <Label text="Prénom :" GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="prenomTfd" GridPane.rowIndex="1" GridPane.columnIndex="1"
                          style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dee2e6; -fx-background-color: white; -fx-padding: 8;"/>
                
                <Label text="Email :" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="emailTfd" GridPane.rowIndex="2" GridPane.columnIndex="1"
                          style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dee2e6; -fx-background-color: white; -fx-padding: 8;"/>
            </GridPane>
            
            <HBox spacing="10" style="-fx-padding: 15 0;">
                <Button text="Ajouter" onAction="#addClient" styleClass="button-success"/>
                <Button text="Modifier" onAction="#updateClient" styleClass="button-primary"/>
                <Button text="Supprimer" onAction="#deleteClient" styleClass="button-danger"/>
            </HBox>
        </VBox>
    </left>
    
    <center>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white;">
            <Label text="Liste des Clients" styleClass="section-label">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
                <style>
                    -fx-text-fill: #2c3e50;
                </style>
            </Label>
            
            <TableView fx:id="clientTable" VBox.vgrow="ALWAYS" onMouseClicked="#selectClient"
                       style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 5;">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="nomCol" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="prenomCol" text="Prénom" prefWidth="150"/>
                    <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
    
</BorderPane>
