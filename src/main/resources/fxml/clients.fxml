<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="clientPane" prefWidth="800.0" prefHeight="600.0" minWidth="600.0" minHeight="400.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.ClientController">

    <center>
        <TableView fx:id="tableClients" prefWidth="700.0" prefHeight="400.0" />
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="20">
            <children>
                <Button fx:id="btnAjouterClient" prefWidth="150.0" prefHeight="50.0" text="Ajouter" />
                <Button fx:id="btnModifierClient" prefWidth="150.0" prefHeight="50.0" text="Modifier" />
                <Button fx:id="btnSupprimerClient" prefWidth="150.0" prefHeight="50.0" text="Supprimer" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
