<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #f4f4f4, #e0e0e0);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.ClientController">

    <!-- Titre principal avec ombre -->
    <Label layoutX="50.0" layoutY="29.0" text="GESTION DES CLIENTS" textFill="#0f0cc6">
        <font>
            <Font name="Arial Bold" size="42.0" />
        </font>
        <effect>
            <DropShadow color="#00000033" radius="10.0" />
        </effect>
    </Label>

    <!-- Section formulaire -->
    <AnchorPane layoutX="45.0" layoutY="96.0" prefHeight="128.0" prefWidth="810.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 20;">

        <!-- Champs de saisie -->
        <TextField fx:id="nomTfd" layoutX="20.0" layoutY="31.0" prefHeight="40.0" prefWidth="180.0" promptText="Nom" style="-fx-background-radius: 8; -fx-font-size: 14px;" />
        <TextField fx:id="prenomTfd" layoutX="220.0" layoutY="31.0" prefHeight="40.0" prefWidth="180.0" promptText="Prénom" style="-fx-background-radius: 8; -fx-font-size: 14px;" />
        <TextField fx:id="emailTfd" layoutX="420.0" layoutY="31.0" prefHeight="40.0" prefWidth="180.0" promptText="Email" style="-fx-background-radius: 8; -fx-font-size: 14px;" />
        <TextField fx:id="searchTfd" layoutX="620.0" layoutY="31.0" onKeyReleased="#searchClient" prefHeight="40.0" prefWidth="150.0" promptText="Rechercher..." style="-fx-background-radius: 8; -fx-font-size: 14px;" />

        <!-- Bouton Ajouter -->
        <Button layoutX="20.0" layoutY="85.0" onAction="#addClient" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 8; -fx-cursor: hand;" text="Ajouter un Client">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
            <effect>
                <DropShadow color="#00000033" radius="5.0" />
            </effect>
        </Button>
    </AnchorPane>

    <!-- TableView améliorée -->
    <TableView fx:id="clientsTable" layoutX="50.0" layoutY="282.0" prefHeight="350.0" prefWidth="800.0" style="-fx-background-color: #ffffff; -fx-border-color: #0f0cc6; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 5;">
        <columns>
            <TableColumn fx:id="nomCol" prefWidth="250.0" style="-fx-alignment: CENTER-LEFT; -fx-font-size: 14px;" text="NOM" />
            <TableColumn fx:id="prenomCol" prefWidth="250.0" style="-fx-alignment: CENTER-LEFT; -fx-font-size: 14px;" text="PRÉNOM" />
            <TableColumn fx:id="emailCol" prefWidth="298.0" style="-fx-alignment: CENTER-LEFT; -fx-font-size: 14px;" text="ADRESSE EMAIL" />
        </columns>
    </TableView>

    <!-- Boutons d'action -->
    <HBox alignment="CENTER_LEFT" layoutX="71.0" layoutY="646.0" spacing="20.0">
        <Button fx:id="updateBtn" onAction="#updateClient" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #FFC107; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="Modifier">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
            <effect>
                <DropShadow color="#00000033" radius="5.0" />
            </effect>
        </Button>
   
        <Button fx:id="deleteBtn" onAction="#deleteClient" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="Supprimer">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
            <effect>
                <DropShadow color="#00000033" radius="5.0" />
            </effect>
        </Button>
   
        <Button onAction="#retour" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="Retour à l'accueil">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
            <effect>
                <DropShadow color="#00000033" radius="5.0" />
            </effect>
        </Button>
    </HBox>

</AnchorPane>
