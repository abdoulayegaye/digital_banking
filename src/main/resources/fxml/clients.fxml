<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="600.0" prefWidth="857.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.ClientController">
    <children>
        <HBox layoutX="10.0" layoutY="10.0">
            <Button fx:id="btnRetour" onAction="#retourAccueil" style="-fx-background-color: transparent;">

            </Button>
        </HBox>
        <Label layoutX="79.0" layoutY="29.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestion des Clients" />
        <Label layoutX="47.0" layoutY="75.0" text="Rechercher :" />
        <TextField fx:id="txtRecherche" layoutX="134.0" layoutY="71.0" prefWidth="200.0" promptText="Entrez un nom ou un prénom" />
        <Button fx:id="btnRechercher" layoutX="351.0" layoutY="68.0" onAction="#rechercherClient" prefHeight="30.0" prefWidth="100.0" text="Rechercher" />
        <TableView fx:id="tableViewClients" layoutX="20.0" layoutY="110.0" prefHeight="350.0" prefWidth="800.0">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="150" text="Nom">
                    <cellValueFactory>
                        <PropertyValueFactory property="nom" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colPrenom" prefWidth="150" text="Prénom">
                    <cellValueFactory>
                        <PropertyValueFactory property="prenom" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colEmail" prefWidth="200" text="Email">
                    <cellValueFactory>
                        <PropertyValueFactory property="email" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <!-- Boutons -->
        <Button fx:id="btnAjouterClient" layoutX="20.0" layoutY="470.0" onAction="#allerAjouterClient" prefHeight="30.0" prefWidth="100.0" text="Ajouter" />
        <Button layoutX="201.0" layoutY="470.0" onAction="#refresh" prefHeight="30.0" prefWidth="100.0" text="Refresh" />
      <Button layoutX="370.0" layoutY="470.0" mnemonicParsing="false" onAction="#Retour_Accueil" prefHeight="30.0" prefWidth="100.0" text="Return" />
    </children>
</AnchorPane>
