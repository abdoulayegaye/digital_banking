<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="549.0" prefWidth="956.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.ClientController">
<children>
    <Button layoutX="358.0" layoutY="12.0" mnemonicParsing="false" prefHeight="50.0" prefWidth="403.0" style="-fx-background-color: #2c3e50;" text="GESTION DES CLIENTS" textFill="white">
        <font>
            <Font size="23.0" />
        </font>
    </Button>

    <Text layoutX="22.0" layoutY="140.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nom :">
        <font>
            <Font size="16.0" />
        </font>
    </Text>
    <TextField fx:id="nomTfd" layoutX="17.0" layoutY="150.0" prefWidth="250.0" promptText="Nom du client" />

    <Text layoutX="22.0" layoutY="210.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Prénom :">
        <font>
            <Font size="16.0" />
        </font>
    </Text>
    <TextField fx:id="prenomTfd" layoutX="17.0" layoutY="220.0" prefWidth="250.0" promptText="Prénom du client" />

    <Text layoutX="22.0" layoutY="280.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Email :">
        <font>
            <Font size="16.0" />
        </font>
    </Text>
    <TextField fx:id="emailTfd" layoutX="17.0" layoutY="290.0" prefWidth="250.0" promptText="email@exemple.com" />

    <TableView fx:id="clientTable" layoutX="300.0" layoutY="100.0" prefHeight="400.0" prefWidth="630.0">
        <columns>
            <TableColumn fx:id="idCol" prefWidth="75" text="ID" />
            <TableColumn fx:id="nomCol" prefWidth="150" text="NOM" />
            <TableColumn fx:id="prenomCol" prefWidth="150" text="PRÉNOM" />
            <TableColumn fx:id="emailCol" prefWidth="255" text="EMAIL" />
        </columns>
    </TableView>

    <ButtonBar layoutY="500.0" prefHeight="40.0" prefWidth="250.0">
        <buttons>
            <Button fx:id="enregistrerBtn" onAction="#enregistrer" style="-fx-background-color: #27ae60;" text="Enregistrer" />
            <Button fx:id="supprimerBtn" onAction="#supprimer" style="-fx-background-color: #e74c3c;" text="Supprimer" />
            <Button fx:id="effacerBtn" onAction="#effacer" style="-fx-background-color: #95a5a6;" text="Effacer" />
            <Button fx:id="modifierBtn" onAction="#modifier" style="-fx-background-color: #f1c40f;" text="Modifier" />
        </buttons>
    </ButtonBar>

    <TextField fx:id="searchTfd" layoutX="300.0" layoutY="70.0" prefWidth="500.0" promptText="Rechercher par nom ou email" />
    <Button fx:id="searchBtn" layoutX="810.0" layoutY="70.0" onAction="#searchClients" style="-fx-background-color: transparent;" text="🔍" />

    <Button fx:id="retourBtn" layoutX="20.0" layoutY="20.0" onAction="#retour" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Retour" />
</children>
</AnchorPane>
