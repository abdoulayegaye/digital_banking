<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.ClientController">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER" maxHeight="50.0" prefHeight="100.0" prefWidth="200.0" spacing="32.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text=" Nom :" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="NomTFD" promptText="Votre Nom" HBox.hgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="10.0" layoutY="10.0" maxHeight="50.0" prefHeight="100.0" prefWidth="200.0" spacing="20.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Prenom :" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="PrenomTFD" promptText="Votre Prenom" HBox.hgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="10.0" layoutY="81.0" maxHeight="50.0" prefHeight="100.0" prefWidth="200.0" spacing="30.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Email :" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="EmailTFD" promptText="Votre Email" HBox.hgrow="ALWAYS" />
                     </children>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <HBox alignment="CENTER" maxHeight="80.0" prefHeight="100.0" prefWidth="200.0" spacing="50.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="ajouterBtn" mnemonicParsing="false" onAction="#add" styleClass="btn-info" text="Ajouter" />
                  <Button fx:id="modifierBtn" mnemonicParsing="false" onAction="#edit" styleClass="btn-success" text="Modifier" />
                  <Button fx:id="consulterBtn" mnemonicParsing="false" onAction="#cons" styleClass="btn-secondary" text="Consulter" />
                  <Button fx:id="supprimerBtn" mnemonicParsing="false" onAction="#delete" styleClass="btn-danger" text="Supprimer" />
               </children>
            </HBox>
            <HBox prefHeight="227.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="clientTb" onMouseClicked="#getData" prefHeight="200.0" prefWidth="373.0" HBox.hgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="idCol" prefWidth="75.0" text="ID" />
                      <TableColumn fx:id="nomCol" prefWidth="75.0" text="Nom" />
                        <TableColumn fx:id="prenomCol" prefWidth="75.0" text="Prenom" />
                        <TableColumn fx:id="emailCol" prefWidth="75.0" text="Email" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
