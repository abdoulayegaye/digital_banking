<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="10" style="-fx-padding: 10;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.ClientController">
    <Label text="Gestion des Clients" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Formulaire pour ajouter/modifier un client -->
    <HBox spacing="10">
        <TextField fx:id="nomField" promptText="Nom"/>
        <TextField fx:id="prenomField" promptText="Prénom"/>
        <TextField fx:id="emailField" promptText="Email"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Ajouter Client" onAction="#handleAjouterClient"/>
        <Button text="Modifier Client" onAction="#handleModifierClient"/>
    </HBox>

    <!-- Tableau pour lister les clients -->
    <TableView fx:id="clientTable">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nomColumn" text="Nom" prefWidth="150"/>
            <TableColumn fx:id="prenomColumn" text="Prénom" prefWidth="150"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200"/>
        </columns>
    </TableView>

    <!-- Boutons pour supprimer, exporter et retourner -->
    <HBox spacing="10">
        <Button text="Supprimer Client" onAction="#handleSupprimerClient"/>
        <Button text="Retour" onAction="#handleRetour"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Supprimer Client" onAction="#handleSupprimerClient"/>
        <Button text="Exporter en PDF" onAction="#exportClientsToPDF"/>
        <Button text="Retour" onAction="#handleRetour"/>
    </HBox>
</VBox>