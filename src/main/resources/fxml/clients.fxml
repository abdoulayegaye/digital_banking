<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.banking.digitalbankingproject.controller.ClientController"
            prefHeight="400.0" prefWidth="800.0">
    <HBox spacing="20" alignment="CENTER" prefWidth="800.0" prefHeight="400.0">

        <!-- Section Gauche : TableView -->
        <VBox spacing="10" prefWidth="400.0" prefHeight="380.0">
            <Button fx:id="btnRetourAccueil" text="Retour à l'accueil" onAction="#retourAccueil"/>
            <!-- TableView pour afficher la liste des clients -->
            <TableView fx:id="tableClients" layoutX="10.0" layoutY="10.0" prefHeight="300.0" prefWidth="350.0" onMouseClicked="#handleTableSelection">
                <columns>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="100.0"/>
                    <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="100.0"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="100.0"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Formulaire d'ajout/édition -->
        <VBox alignment="CENTER_LEFT" spacing="10" layoutX="320.0" layoutY="10.0" style="-fx-background-color: #f0f0f0; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10;">
            <Label text="Nom" style="-fx-font-weight: bold;"/>
            <TextField fx:id="nomField" prefWidth="150.0" style="-fx-background-color: #ffffff; -fx-border-color: #ccc; -fx-border-radius: 5;"/>

            <Label text="Prénom" style="-fx-font-weight: bold;"/>
            <TextField fx:id="prenomField" prefWidth="150.0" style="-fx-background-color: #ffffff; -fx-border-color: #ccc; -fx-border-radius: 5;"/>

            <Label text="Email" style="-fx-font-weight: bold;"/>
            <TextField fx:id="emailField" prefWidth="150.0" style="-fx-background-color: #ffffff; -fx-border-color: #ccc; -fx-border-radius: 5;"/>
        </VBox>

        <!-- Boutons Ajouter, Modifier, Supprimer alignés horizontalement -->
        <VBox spacing="10" alignment="CENTER" layoutX="320.0" layoutY="220.0">
            <Button fx:id="btnAjouter" text="Ajouter" onAction="#ajouterClient" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold; -fx-border-radius: 5;"/>
            <Button fx:id="btnModifier" text="Modifier" onAction="#modifierClient" style="-fx-background-color: #FFA500; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold; -fx-border-radius: 5;"/>
            <Button fx:id="btnSupprimer" text="Supprimer" onAction="#supprimerClient" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold; -fx-border-radius: 5;"/>
        </VBox>
    </HBox>
</AnchorPane>
