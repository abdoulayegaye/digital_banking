<AnchorPane prefHeight="433.0" prefWidth="635.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.InterfaceOperationsController">
   <children>
      <ImageView fitHeight="50.0" fitWidth="63.0" layoutX="203.0" layoutY="3.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/operation-dargent.png" />
         </image>
      </ImageView>
      <Text layoutX="253.0" layoutY="36.0" strokeType="OUTSIDE" strokeWidth="0.0" text="OPERATIONS BANCAIRES">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Text>
      <Button fx:id="depotBtn" layoutX="169.0" layoutY="148.0" mnemonicParsing="false" onAction="#depot" text="Dépôt" />
      <Button fx:id="retraitBtn" layoutX="383.0" layoutY="149.0" mnemonicParsing="false" onAction="#retrait" text="Retrait" />
      <Button fx:id="virementBtn" layoutX="271.0" layoutY="148.0" mnemonicParsing="false" onAction="#virement" text="Virement" />
      <Button fx:id="homeBtn" layoutX="14.0" layoutY="15.0" mnemonicParsing="false" onAction="#home" text="🏠" />
