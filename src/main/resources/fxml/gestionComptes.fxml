<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.GestionCompteController">
   <top>
      <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="Gestion des Comptes" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnRetour" mnemonicParsing="false" onAction="#handleRetour" text="Retour" />
                  <Button fx:id="btnNouveauCompte" mnemonicParsing="false" onAction="#handleNouveauCompte" text="Nouveau Compte" />
                  <Button fx:id="btnFermerCompte" mnemonicParsing="false" onAction="#handleFermerCompte" text="Fermer Compte" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <SplitPane dividerPositions="0.5" orientation="VERTICAL" BorderPane.alignment="CENTER">
         <items>
            <VBox spacing="10.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Filtrer par client:" />
                        <ComboBox fx:id="comboClients" prefWidth="200.0" promptText="Sélectionner un client" />
                        <Button fx:id="btnFiltrer" mnemonicParsing="false" onAction="#handleFiltrer" text="Filtrer" />
                        <Button fx:id="btnTous" mnemonicParsing="false" onAction="#handleAfficherTous" text="Tous les comptes" />
                     </children>
                  </HBox>
                  <TableView fx:id="tableComptes" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                        <TableColumn fx:id="colSolde" prefWidth="150.0" text="Solde" />
                        <TableColumn fx:id="colClientId" prefWidth="150.0" text="Client ID" />
                        <TableColumn fx:id="colClientNom" prefWidth="200.0" text="Nom du Client" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
            <VBox fx:id="formContainer" spacing="10.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <TitledPane animated="false" text="Détails du Compte">
                     <content>
                        <GridPane hgap="10.0" vgap="10.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <Label text="ID:" />
                              <Label text="Solde:" GridPane.rowIndex="1" />
                              <Label text="Client:" GridPane.rowIndex="2" />
                              <TextField fx:id="txtId" disable="true" GridPane.columnIndex="1" />
                              <TextField fx:id="txtSolde" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              <ComboBox fx:id="comboClientSelection" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </GridPane>
                     </content>
                  </TitledPane>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button fx:id="btnEnregistrer" mnemonicParsing="false" onAction="#handleEnregistrer" text="Enregistrer" />
                        <Button fx:id="btnAnnuler" mnemonicParsing="false" onAction="#handleAnnuler" text="Annuler" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </items>
      </SplitPane>
   </center>
</BorderPane> 