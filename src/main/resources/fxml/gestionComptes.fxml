<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="gestionComptesPane" prefHeight="600.0" prefWidth="857.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.GestionComptesController">
    <children>
        <HBox layoutX="10.0" layoutY="10.0">
            <Button fx:id="btnRetour" onAction="#retourAccueil" style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fitHeight="51.0" fitWidth="49.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/retour.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <Label layoutX="314.0" layoutY="22.0" prefHeight="38.0" prefWidth="184.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestion des Comptes" textFill="#381394">
         <font>
            <Font name="Times New Roman" size="52.0" />
         </font></Label>

        <!-- Barre de recherche -->
        <Label layoutX="439.0" layoutY="233.0" text="Rechercher :" />
        <TextField fx:id="txtRecherche" layoutX="519.0" layoutY="233.0" prefWidth="200.0" promptText="Entrez un numéro de compte ou un nom" />
        <Button fx:id="btnRechercher" layoutX="729.0" layoutY="233.0" onAction="#rechercherCompte" prefHeight="30.0" prefWidth="100.0" text="Rechercher" />

        <!-- TableView pour afficher les comptes -->
        <TableView fx:id="tableViewComptes" layoutX="29.0" layoutY="270.0" prefHeight="225.0" prefWidth="800.0">
            <columns>
                <TableColumn fx:id="colNumero" prefWidth="150" text="Numéro de compte">
                    <cellValueFactory>
                        <PropertyValueFactory property="numero" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colClient" prefWidth="200" text="Client">
                    <cellValueFactory>
                        <PropertyValueFactory property="nomCompletClient" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colSolde" prefWidth="100" text="Solde">
                    <cellValueFactory>
                        <PropertyValueFactory property="balance" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colEtat" prefWidth="100" text="État">
                    <cellValueFactory>
                        <PropertyValueFactory property="etat" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colDate" prefWidth="150" text="Date d'ouverture">
                    <cellValueFactory>
                        <PropertyValueFactory property="createdAt" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <!-- Boutons -->
        <Button fx:id="btnAjouterCompte" layoutX="204.0" layoutY="512.0" onAction="#allerAjouterCompte" prefHeight="30.0" prefWidth="100.0" text="Ajouter" />
        <Button fx:id="btnModifierCompte" layoutX="314.0" layoutY="512.0" onAction="#allerModifierCompte" prefHeight="30.0" prefWidth="100.0" text="Modifier" />
        <Button fx:id="btnSupprimerCompte" layoutX="424.0" layoutY="512.0" onAction="#allerSupprimerCompte" prefHeight="30.0" prefWidth="100.0" text="Supprimer" />
        <Button fx:id="btnRefresh" layoutX="534.0" layoutY="512.0" onAction="#rafraichirComptes" prefHeight="30.0" prefWidth="100.0" text="Refresh" />
        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="331.0" layoutY="82.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/icone%20gestion%20des%20comptes.png" />
            </image>
        </ImageView>
    </children>
</AnchorPane>
