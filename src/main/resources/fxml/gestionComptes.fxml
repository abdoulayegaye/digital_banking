<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:id="gestionComptesPane" prefHeight="600.0" prefWidth="857.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="com.banking.digitalbankingproject.controller.GestionComptesController">
    <children>
        <HBox layoutX="10.0" layoutY="10.0">
            <Button fx:id="btnRetour" onAction="#retourAccueil" style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../../../../../../../Users/CnG/Pictures/fleche%20de%20retour.jpg" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <Label layoutX="20.0" layoutY="40.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestion des Comptes"/>

        <!-- Barre de recherche -->
        <Label layoutX="20.0" layoutY="70.0" text="Rechercher :"/>
        <TextField fx:id="txtRecherche" layoutX="100.0" layoutY="70.0" prefWidth="200.0" promptText="Entrez un numéro de compte ou un nom"/>
        <Button fx:id="btnRechercher" layoutX="310.0" layoutY="70.0" onAction="#rechercherCompte" prefHeight="30.0"
                prefWidth="100.0" text="Rechercher"/>

        <!-- TableView pour afficher les comptes -->
        <TableView fx:id="tableViewComptes" layoutX="20.0" layoutY="110.0" prefHeight="350.0" prefWidth="800.0">
            <columns>
                <TableColumn fx:id="colNumero" prefWidth="150" text="Numéro de compte">
                    <cellValueFactory>
                        <PropertyValueFactory property="numero"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colClient" prefWidth="200" text="Client">
                    <cellValueFactory>
                        <PropertyValueFactory property="nomCompletClient"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colSolde" prefWidth="100" text="Solde">
                    <cellValueFactory>
                        <PropertyValueFactory property="balance"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colEtat" prefWidth="100" text="État">
                    <cellValueFactory>
                        <PropertyValueFactory property="etat"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colDate" prefWidth="150" text="Date d'ouverture">
                    <cellValueFactory>
                        <PropertyValueFactory property="createdAt"/>
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <!-- Boutons -->
        <Button fx:id="btnAjouterCompte" layoutX="20.0" layoutY="470.0" onAction="#allerAjouterCompte" prefHeight="30.0"
                prefWidth="100.0" text="Ajouter"/>
        <Button fx:id="btnModifierCompte" layoutX="130.0" layoutY="470.0" onAction="#allerModifierCompte" prefHeight="30.0"
                prefWidth="100.0" text="Modifier"/>
        <Button fx:id="btnSupprimerCompte" layoutX="240.0" layoutY="470.0" onAction="#allerSupprimerCompte" prefHeight="30.0"
                prefWidth="100.0" text="Supprimer"/>
        <Button fx:id="btnRefresh" layoutX="350.0" layoutY="470.0" onAction="#rafraichirComptes" prefHeight="30.0"
                prefWidth="100.0" text="Refresh"/>
        <Button fx:id="btnRetour" alignment="BOTTOM_LEFT" mnemonicParsing="false" onAction="#retourAccueil">
            <graphic>
                <ImageView fx:id="imgRetour" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/retour.png" />
                    </image>
                </ImageView>
            </graphic>
            <text>Retour</text>
        </Button>
    </children>
</AnchorPane>