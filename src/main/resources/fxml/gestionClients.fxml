<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.banking.digitalbankingproject.controller.GestionClientController">
   <top>
      <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="Gestion des Clients" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnRetour" mnemonicParsing="false" onAction="#handleRetour" text="Retour" />
                  <Button fx:id="btnNouveauClient" mnemonicParsing="false" onAction="#handleNouveauClient" text="Nouveau Client" />
                  <Button fx:id="btnModifierClient" mnemonicParsing="false" onAction="#handleModifierClient" text="Modifier" />
                  <Button fx:id="btnSupprimerClient" mnemonicParsing="false" onAction="#handleSupprimerClient" text="Supprimer" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label text="Rechercher:" />
                  <TextField fx:id="txtRecherche" promptText="Nom ou prénom du client" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnRechercher" mnemonicParsing="false" onAction="#handleRechercher" text="Rechercher" />
               </children>
            </HBox>
            <TableView fx:id="tableClients" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                  <TableColumn fx:id="colNom" prefWidth="150.0" text="Nom" />
                  <TableColumn fx:id="colPrenom" prefWidth="150.0" text="Prénom" />
                  <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
   <bottom>
      <VBox fx:id="formContainer" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <TitledPane animated="false" text="Détails du Client">
               <content>
                  <GridPane hgap="10.0" vgap="10.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Label text="ID:" />
                        <Label text="Nom:" GridPane.rowIndex="1" />
                        <Label text="Prénom:" GridPane.rowIndex="2" />
                        <Label text="Email:" GridPane.rowIndex="3" />
                        <TextField fx:id="txtId" disable="true" GridPane.columnIndex="1" />
                        <TextField fx:id="txtNom" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <TextField fx:id="txtPrenom" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </GridPane>
               </content>
            </TitledPane>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnEnregistrer" mnemonicParsing="false" onAction="#handleEnregistrer" text="Enregistrer" />
                  <Button fx:id="btnAnnuler" mnemonicParsing="false" onAction="#handleAnnuler" text="Annuler" />
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane> 