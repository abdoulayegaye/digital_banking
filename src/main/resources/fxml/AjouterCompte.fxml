<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.banking.digitalbankingproject.controller.AjouterCompteController">
    <children>
        <Label layoutX="50.0" layoutY="50.0" text="Solde:"/>
        <TextField fx:id="txtSolde" layoutX="100.0" layoutY="50.0"/>
        <Label layoutX="50.0" layoutY="100.0" text="Actif:"/>
        <CheckBox fx:id="chkActif" layoutX="100.0" layoutY="100.0"/>
        <Button fx:id="btnAjouter" layoutX="50.0" layoutY="150.0" text="Ajouter" onAction="#ajouterCompte"/>
        <Button fx:id="btnRetour" layoutX="150.0" layoutY="150.0" text="Retour" onAction="#retourGestionComptes"/>
    </children>
</AnchorPane>